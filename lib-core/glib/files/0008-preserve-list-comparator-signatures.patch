 {
   GSList *tmp_list = list;
   GSList *prev_list = NULL;
@@ -869,14 +879,14 @@ g_slist_insert_sorted_real (GSList   *list,
       return new_list;
     }
 
-  cmp = ((GCompareDataFunc) func) (data, tmp_list->data, user_data);
