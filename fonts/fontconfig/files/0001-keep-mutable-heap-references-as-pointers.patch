diff --git a/test/test-heap-references.c b/test/test-heap-references.c
new file mode 100644
--- /dev/null
+++ b/test/test-heap-references.c
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: HPND */
+#include <assert.h>
+#include <stddef.h>
+#include <fontconfig/fontconfig.h>
+
+#if defined(__has_feature)
+#  if __has_feature(address_sanitizer)
+#    define CHECK_LEAKS 1
+#  endif
+#endif
+#if defined(__SANITIZE_ADDRESS__)
+#  define CHECK_LEAKS 1
+#endif
+
+#ifdef CHECK_LEAKS
+#  include <sanitizer/lsan_interface.h>
+#  define NOINLINE __attribute__((noinline))
+#else
+#  define NOINLINE
+#endif
+
+static FcPattern *pattern;
+static FcCharSet *charset;
+
+static NOINLINE void
+create_objects (void)
+{
+    unsigned int i;
+
+    pattern = FcPatternCreate ();
+    assert (pattern);
+    assert (FcPatternAddString (pattern, FC_FAMILY, (const FcChar8 *)"reachable family"));
+    charset = FcCharSetCreate ();
+    assert (charset);
+    /* Grow both arrays several times and retain every allocated leaf. */
+    for (i = 0; i < 33; i++)
+        assert (FcCharSetAddChar (charset, i * 256));
+}
+
+int
+main (void)
+{
+    unsigned int i;
+    int reachable = 0, released = 0;
+
+    create_objects ();
+    for (i = 0; i < 33; i++)
+        assert (FcCharSetHasChar (charset, i * 256));
+
+#ifdef CHECK_LEAKS
+    reachable = __lsan_do_recoverable_leak_check ();
+#endif
+    FcPatternDestroy (pattern);
+    FcCharSetDestroy (charset);
+    pattern = NULL;
+    charset = NULL;
+#ifdef CHECK_LEAKS
+    released = __lsan_do_recoverable_leak_check ();
+#endif
+    return reachable || released;
+}
