#!/bin/bash

set -e
umask 077

temporary=
trap '[[ -z ${temporary} ]] || rm -f -- "${temporary}"' EXIT
trap 'exit 1' HUP INT TERM

CONFIG_FILE="/etc/lighttpd/lighttpd_cert_domains.conf"

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: Configuration file $CONFIG_FILE not found."
    exit 1
fi

if ! grep -qE '^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$' "$CONFIG_FILE"; then
    echo "Error: Configuration file $CONFIG_FILE is either empty or contains invalid domain names."
    exit 1
fi

while IFS= read -r line; do
    if [[ ! "$line" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
        echo "Skipping invalid domain entry: $line"
        continue
    fi

    certbot certonly --webroot -w "/var/lighttpd/${line}" -d "${line}" -d "www.${line}" --expand --force-renewal --key-type ecdsa --cert-name "${line}" --quiet

    directory="/etc/letsencrypt/live/${line}"
    temporary=$(mktemp "${directory}/.web.pem.XXXXXX")
    cat "${directory}/cert.pem" "${directory}/privkey.pem" > "${temporary}"
    certificate_key=$(openssl x509 -in "${temporary}" -pubkey -noout)
    private_key=$(openssl pkey -in "${temporary}" -pubout -passin pass:)
    if [[ ${certificate_key} != "${private_key}" ]]; then
        echo "Certificate and private key do not match for ${line}." >&2
        exit 1
    fi
    mv -f -- "${temporary}" "${directory}/web.pem"
    temporary=
done < "$CONFIG_FILE"
