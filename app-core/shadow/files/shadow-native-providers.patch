diff --git a/tests/unit/test_native_providers.c b/tests/unit/test_native_providers.c
new file mode 100644
index 0000000..185dfc2
--- /dev/null
+++ b/tests/unit/test_native_providers.c
@@ -0,0 +1,76 @@
+#include "config.h"
+
+#include <errno.h>
+#include <openssl/crypto.h>
+#include <openssl/rand.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "agetpass.h"
+#include "defines.h"
+#include "prototypes.h"
+
+static int rng_result = 1;
+static int erased;
+
+void __real_OPENSSL_clear_free(void *, size_t);
+void __wrap_OPENSSL_clear_free(void *, size_t);
+
+void
+__wrap_OPENSSL_clear_free(void *ptr, size_t len)
+{
+    if (len != PASS_MAX + 2)
+        _exit(98);
+    erased++;
+    __real_OPENSSL_clear_free(ptr, len);
+}
+
+int
+RAND_bytes(unsigned char *buf, int len)
+{
+    memset(buf, 0xa5, len);
+    return rng_result;
+}
+
+int
+main(void)
+{
+    unsigned long expected;
+    char *pass;
+    int status, pipefd[2];
+    pid_t pid;
+
+    memset(&expected, 0xa5, sizeof(expected));
+    if (csrand() != expected)
+        return 1;
+    for (rng_result = 0; rng_result >= -1; rng_result--) {
+        pid = fork();
+        if (pid == -1)
+            return 1;
+        if (pid == 0) {
+            (void)csrand();
+            _exit(99);
+        }
+        if (waitpid(pid, &status, 0) != pid ||
+            !WIFEXITED(status) || WEXITSTATUS(status) != 1)
+            return 1;
+    }
+
+    if (pipe(pipefd) != 0)
+        return 1;
+    if (write(pipefd[1], "Secret42\n", 9) != 9)
+        return 1;
+    close(pipefd[1]);
+    if (dup2(pipefd[0], STDIN_FILENO) == -1)
+        return 1;
+    close(pipefd[0]);
+    pass = agetpass_stdin();
+    if (!pass || strcmp(pass, "Secret42") != 0)
+        return 1;
+    erase_pass(pass);
+    if (erased != 1)
+        return 1;
+    return 0;
+}
