Use SHA-256 for the local connection hash without a SHA-1 fallback.
The %C expansion changes from 40 to 64 hex characters; existing socket
and file names using this token are not reused. Wire algorithms do not change.

--- a/readconf.c
+++ b/readconf.c
@@ -351 +351 @@ ssh_connection_hash
-	if ((md = ssh_digest_start(SSH_DIGEST_SHA1)) == NULL ||
+	if ((md = ssh_digest_start(SSH_DIGEST_SHA256)) == NULL ||
@@ -360 +360 @@ ssh_connection_hash
-	return tohex(conn_hash, ssh_digest_bytes(SSH_DIGEST_SHA1));
+	return tohex(conn_hash, ssh_digest_bytes(SSH_DIGEST_SHA256));
--- a/regress/percent.sh
+++ b/regress/percent.sh
@@ -110 +110 @@
-		    $OPENSSL_BIN sha1 | cut -f2 -d' '`
+		    $OPENSSL_BIN sha256 | cut -f2 -d' '`
--- a/ssh_config.5
+++ b/ssh_config.5
@@ -2346,7 +2346,9 @@ Tokens available are:
 A literal
 .Sq % .
 .It \&%C
-Hash of %l%h%p%r%j.
+SHA-256 hash of %l%h%p%r%j, encoded as 64 hexadecimal characters.
+Paths using this token differ from those generated by clients using SHA-1.
+Control socket paths must still fit the operating system's path length limit.
 .It %d
 Local user's home directory.
 .It %f
