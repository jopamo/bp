--- /dev/null
+++ b/stdio-common/tst-printf-format-c.py
@@ -0,0 +1,20 @@
+"""Check the %c cases as bytes: the data includes both NUL and UCHAR_MAX."""
+import sys
+
+value = None
+cases = 0
+for record in sys.stdin.buffer:
+    if record.startswith(b'val:'):
+        value = record[4:-1]
+        if len(value) != 1:
+            sys.exit('invalid character: %r' % value)
+        continue
+    if value is None or not record.endswith(b':\n'):
+        sys.exit('invalid test record: %r' % record)
+    fmt, *width, actual = record[:-2].split(b':')
+    expected = fmt % (tuple(map(int, width)) + (value,))
+    if actual != expected:
+        sys.exit('%r, %r => %r, expected %r' % (fmt, value, actual, expected))
+    cases += 1
+if not cases:
+    sys.exit('missing character conversions')
