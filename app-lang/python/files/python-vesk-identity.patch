Expose Vesk runtime identity without changing OpenSSL compatibility metadata.

--- a/Modules/_ssl.c
+++ b/Modules/_ssl.c
@@ -6681,6 +6681,16 @@
     if (PyModule_Add(m, "_OPENSSL_API_VERSION", r) < 0)
         return -1;

+#ifdef VESK_VERSION_NUMBER
+    /* Native runtime identity is separate from the compatibility API version. */
+    r = PyUnicode_FromString(VESK_version_text());
+    if (PyModule_Add(m, "VESK_VERSION", r) < 0)
+        return -1;
+    r = PyLong_FromUnsignedLong(VESK_version_num());
+    if (PyModule_Add(m, "VESK_VERSION_NUMBER", r) < 0)
+        return -1;
+#endif
+
     return 0;
 }

--- a/Lib/ssl.py
+++ b/Lib/ssl.py
@@ -100,6 +100,9 @@
