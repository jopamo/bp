 from _ssl import OPENSSL_VERSION_NUMBER, OPENSSL_VERSION_INFO, OPENSSL_VERSION
+if hasattr(_ssl, 'VESK_VERSION_NUMBER'):
+    from _ssl import VESK_VERSION, VESK_VERSION_NUMBER
+
