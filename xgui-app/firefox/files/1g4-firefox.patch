+add_task(async function test_idle_backup_canceled_when_schedule_changes() {
+  let bs = BackupService.init();
+  let sandbox = sinon.createSandbox();
+  let createBackup = sandbox.stub(bs, "createBackup").resolves({
+    archivePath: "",
+  });
+
+  try {
+    for (let reenable of [false, true]) {
+      let queued = bs.createBackupOnIdleDispatch({
+        reason: "idle",
+        deletePreviousBackup: false,
+      });
+      Services.prefs.setBoolPref(SCHEDULED_BACKUPS_ENABLED_PREF_NAME, false);
+      if (reenable) {
+        Services.prefs.setBoolPref(SCHEDULED_BACKUPS_ENABLED_PREF_NAME, true);
+      }
+      await queued;
+      Assert.ok(
+        createBackup.notCalled,
+        reenable
+          ? "Turning the schedule back on does not revive an old request"
+          : "The queued backup does not start after its schedule is disabled"
+      );
+      Services.prefs.setBoolPref(SCHEDULED_BACKUPS_ENABLED_PREF_NAME, true);
+    }
+
+    await bs.createBackupOnIdleDispatch({
+      reason: "idle",
+      deletePreviousBackup: false,
+    });
+    Assert.ok(createBackup.calledOnce, "A newly queued backup can still run");
+  } finally {
+    Services.prefs.setBoolPref(SCHEDULED_BACKUPS_ENABLED_PREF_NAME, true);
+    sandbox.restore();
+    BackupService.uninit();
+  }
+});
