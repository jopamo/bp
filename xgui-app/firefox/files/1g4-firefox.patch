diff --git a/services/settings/test/unit/test_remote_settings_1g4.js b/services/settings/test/unit/test_remote_settings_1g4.js
new file mode 100644
index 0000000000000000000000000000000000000000..2b90c40850b268de3596e310a38f2f73dfab2439
--- /dev/null
+++ b/services/settings/test/unit/test_remote_settings_1g4.js
@@ -0,0 +1,108 @@
+/* Any copyright is dedicated to the Public Domain.
+   http://creativecommons.org/publicdomain/zero/1.0/ */
+
+add_task(
+  { skip_if: () => !AppConstants.MOZ_1G4_PRIVACY },
+  async function test_1g4_remote_settings_uses_only_packaged_data() {
+    const server = new HttpServer();
+    server.start(-1);
+    registerCleanupFunction(() => server.stop(() => {}));
+    const origin = `http://localhost:${server.identity.primaryPort}`;
+    let requests = 0;
+    server.registerPrefixHandler("/", (_request, response) => {
+      ++requests;
+      response.setStatusLine(null, 500, "Remote Settings must stay offline");
+    });
+    Services.prefs.setStringPref("services.settings.server", `${origin}/v2`);
+
+    Assert.ok(Utils.shouldSkipRemoteActivity);
+    Assert.ok(Utils.LOAD_DUMPS);
+
+    function onlyPackagedData(client) {
+      // Even an upgraded profile with a Remote Settings cache must not use it.
+      Object.defineProperty(client, "db", {
+        get() {
+          Assert.ok(false, `Opened the profile cache for ${client.identifier}`);
+          throw new Error("Remote Settings profile cache must stay unused");
+        },
+        configurable: true,
+      });
+      registerCleanupFunction(() => delete client.db);
+      return client;
+    }
+
+    for (const name of [
+      "devtools-compatibility-browsers",
+      "devtools-devices",
+      "language-dictionaries",
+      "search-config-v3",
+    ]) {
+      const client = onlyPackagedData(RemoteSettings(name));
+      const { data } = await SharedUtils.loadJSONDump("main", name);
+      Assert.ok(data.length > 0);
+      Assert.deepEqual(
+        await client.get({ forceSync: true, filters: { id: data[0].id } }),
+        [data[0]]
+      );
+      await client.sync();
+      await client.maybeSync(Date.now());
+      Assert.equal(await client.attachments.cacheAll(true), null);
+    }
+    Assert.deepEqual(
+      await onlyPackagedData(RemoteSettings("urlbar-persisted-search-terms")).get({
+        forceSync: true,
+      }),
+      []
+    );
+    const security = onlyPackagedData(
+      RemoteSettings("onecrl", { bucketName: "security-state" })
+    );
+    Assert.ok((await security.get({ forceSync: true })).length > 0);
+    await security.sync();
+    await security.maybeSync(Date.now());
+    Assert.equal(await security.attachments.cacheAll(true), null);
+    await Assert.rejects(
+      security.attachments.downloadAsBytes({}),
+      /no remote attachments/
+    );
+    const blocklist = onlyPackagedData(
+      RemoteSettings("addons-bloomfilters", { bucketName: "blocklists" })
+    );
+    const { buffer, _source } = await blocklist.attachments.download(undefined, {
+      attachmentId: "addons-mlbf.bin",
+      fallbackToCache: true,
+      fallbackToDump: true,
+    });
+    Assert.equal(_source, "dump_fallback");
+    Assert.greater(buffer.byteLength, 0);
+    Assert.ok(!(await blocklist.attachments.isDownloaded({ id: "old" })));
+    await blocklist.attachments.deleteDownloaded({ id: "old" });
+    await blocklist.attachments.deleteAll();
+    Assert.equal(await blocklist.attachments.prune([]), 0);
+    await Assert.rejects(
+      blocklist.attachments.get({ id: "not-in-the-package" }),
+      /Could not find/
+    );
+
+    RemoteSettings.init();
+    RemoteSettings.enablePreviewMode(true);
+    const status = await RemoteSettings.inspect();
+    Assert.equal(status.serverURL, null);
+    Assert.equal(status.serverTimestamp, null);
+    Assert.equal(status.previewMode, false);
+    Assert.deepEqual(status.collections, []);
+    Assert.deepEqual(status.history["settings-sync"], []);
+    await RemoteSettings.clearAll();
+    await RemoteSettings.pollChanges({ full: true });
+    Assert.deepEqual(await RemoteSettings.pullStartupBundle(), []);
+    await Assert.rejects(
+      Utils.fetch(`${origin}/v2/`),
+      /network access is disabled/
+    );
+    Assert.equal(
+      await RemoteSettingsWorker.checkFileHash(`${origin}/file`, 0, ""),
+      false
+    );
+    Assert.equal(requests, 0);
+  }
+);
