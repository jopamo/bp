@@ -1,5 +1,15 @@
 # Generate dl-tunable-list.h from dl-tunables.list
 
+# The keys are strings; do not depend on awk array traversal order.
+function sorted_keys(keys, ordered,    key, i, n) {
+  for (key in keys) {
+    for (i = ++n; i > 1 && ordered[i-1] > key; --i)
+      ordered[i] = ordered[i-1];
+    ordered[i] = key;
+  }
+  return n;
+}
