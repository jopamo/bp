+
+  let lockName = BackupService.WRITE_BACKUP_LOCK_NAME;
+  let lockHeld = Promise.withResolvers();
+  let release = Promise.withResolvers();
+  let holder = locks.request(lockName, () => {
+    lockHeld.resolve();
+    return release.promise;
+  });
+  let queued;
+  try {
+    await lockHeld.promise;
+    queued = bs.createBackupOnIdleDispatch({ reason: "idle" });
+    await TestUtils.waitForCondition(async () => {
+      let { pending } = await locks.query();
+      return pending.some(lock => lock.name == lockName);
+    }, "The queued backup is waiting on the write lock");
+
+    Services.prefs.setBoolPref(SCHEDULED_BACKUPS_ENABLED_PREF_NAME, false);
