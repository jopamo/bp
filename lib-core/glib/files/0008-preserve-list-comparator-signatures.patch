diff --git a/glib/tests/list.c b/glib/tests/list.c
--- a/glib/tests/list.c
+++ b/glib/tests/list.c
@@ -23,13 +23,30 @@ sort (gconstpointer p1, gconstpointer p2)
 /*
  * glist sort tests
  */
+static gint
+sort_with_data (gconstpointer p1, gconstpointer p2, gpointer data)
+{
+  g_assert_true (data == array);
+  return sort (p1, p2);
+}
+
+static gint
+sort_strings (gconstpointer p1, gconstpointer p2)
+{
+  return g_strcmp0 (p1, p2);
+}
+
 static void
 test_list_sort (void)
 {
   GList *list = NULL;
   gint   i;
 
-  for (i = 0; i < SIZE; i++)
+  g_assert_null (g_list_sort (NULL, sort));
+  list = g_list_append (list, GINT_TO_POINTER (array[0]));
+  g_assert_true (g_list_sort (list, sort) == list);
+
+  for (i = 1; i < SIZE; i++)
     list = g_list_append (list, GINT_TO_POINTER (array[i]));
 
   list = g_list_sort (list, sort);
@@ -55,7 +72,7 @@ test_list_sort_with_data (void)
   for (i = 0; i < SIZE; i++)
     list = g_list_append (list, GINT_TO_POINTER (array[i]));
 
-  list = g_list_sort_with_data (list, (GCompareDataFunc)sort, NULL);
+  list = g_list_sort_with_data (list, sort_with_data, array);
   for (i = 0; i < SIZE - 1; i++)
     {
       gpointer p1, p2;
@@ -83,7 +100,7 @@ test_list_sort_stable (void)
 
   /* Take a copy and sort it. */
   copy = g_list_copy (list);
-  copy = g_list_sort (copy, (GCompareFunc) g_strcmp0);
+  copy = g_list_sort (copy, sort_strings);
 
   /* Compare the two lists, checking pointers are equal to ensure the elements
    * have been kept stable. */
@@ -92,7 +109,7 @@ test_list_sort_stable (void)
       gpointer p1, p2;
 
       p1 = g_list_nth_data (list, i);
-      p2 = g_list_nth_data (list, i);
+      p2 = g_list_nth_data (copy, i);
 
       g_assert (p1 == p2);
     }
@@ -107,6 +124,10 @@ test_list_insert_sorted (void)
   GList *list = NULL;
   gint   i;
 
+  g_test_expect_message ("GLib", G_LOG_LEVEL_CRITICAL, "*func != NULL*");
+  g_assert_null (g_list_insert_sorted (NULL, NULL, NULL));
+  g_test_assert_expected_messages ();
+
   for (i = 0; i < SIZE; i++)
     list = g_list_insert_sorted (list, GINT_TO_POINTER (array[i]), sort);
 
@@ -132,8 +153,8 @@ test_list_insert_sorted_with_data (void)
   for (i = 0; i < SIZE; i++)
     list = g_list_insert_sorted_with_data (list,
                                            GINT_TO_POINTER (array[i]),
-                                           (GCompareDataFunc)sort,
-                                           NULL);
+                                           sort_with_data,
+                                           array);
 
   for (i = 0; i < SIZE - 1; i++)
     {
diff --git a/glib/tests/slist.c b/glib/tests/slist.c
