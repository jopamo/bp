diff --git a/src/test-random.c b/src/test-random.c
new file mode 100644
index 0000000..ea58e5b
--- /dev/null
+++ b/src/test-random.c
@@ -0,0 +1,51 @@
+#include <X11/ICE/ICElib.h>
+#include <X11/ICE/ICEutil.h>
+#include <openssl/rand.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int rng_result = 1;
+static int calls;
+
+int
+RAND_bytes(unsigned char *buf, int len)
+{
+    calls++;
+    memset(buf, 0xa5, len);
+    return rng_result;
+}
+
+int
+main(void)
+{
+    char *cookie;
+    int i, before;
+
+    cookie = IceGenerateMagicCookie(16);
+    if (!cookie)
+        return 1;
+    for (i = 0; i < 16; i++)
+        if ((unsigned char)cookie[i] != 0xa5)
+            return 1;
+    if (cookie[16] != '\0' || calls != 1)
+        return 1;
+    free(cookie);
+
+    cookie = IceGenerateMagicCookie(0);
+    if (!cookie || *cookie != '\0')
+        return 1;
+    free(cookie);
+    before = calls;
+    errno = 0;
+    if (IceGenerateMagicCookie(-1) != NULL ||
+        errno != EINVAL || calls != before)
+        return 1;
+
+    for (rng_result = 0; rng_result >= -1; rng_result--) {
+        errno = 0;
+        if (IceGenerateMagicCookie(16) != NULL || errno != EIO)
+            return 1;
+    }
+    return 0;
+}
