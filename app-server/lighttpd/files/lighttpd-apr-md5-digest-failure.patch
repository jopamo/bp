+#ifdef USE_LIB_CRYPTO_MD5
+static int apr_md5_init(MD5_CTX *ctx) {
+    if (MD5_Init(ctx)) return 1;
+  #if defined(USE_OPENSSL_CRYPTO) && (OPENSSL_VERSION_NUMBER >= 0x30000000L \
+    || LIBRESSL_VERSION_NUMBER >= 0x3080000fL)
+    EVP_MD_CTX_free(*ctx);
+  #endif
+    return 0;
+}
+#define APR_MD5_INIT(ctx) apr_md5_init(ctx)
+#define APR_MD5_UPDATE(ctx, data, len) MD5_Update(ctx, data, len)
+#define APR_MD5_FINAL(out, ctx) MD5_Final(out, ctx)
+#else
+#define APR_MD5_INIT(ctx) (MD5_Init(ctx), 1)
+#define APR_MD5_UPDATE(ctx, data, len) (MD5_Update(ctx, data, len), 1)
+#define APR_MD5_FINAL(out, ctx) (MD5_Final(out, ctx), 1)
+#endif
