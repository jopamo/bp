the field only on compilers that provide it.

--- a/bundles/stdcompat/stdcompat-current/configure.ac
+++ b/bundles/stdcompat/stdcompat-current/configure.ac
@@ -185,6 +185,7 @@
 AC_WITH_OCAML_VERSION([5_1_0], [5.1.0])
