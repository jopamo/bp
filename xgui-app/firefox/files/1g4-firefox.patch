+  await PlacesUtils.history.clear();
+  const older = "https://older.example.com/sidebar-history";
+  const recent = "https://recent.example.com/sidebar-history";
+  const hour = 60 * 60 * 1000;
+  const now = Date.now();
+  await PlacesUtils.history.insertMany([
+    { url: older, visits: [{ date: new Date(now - 2 * hour) }] },
+    { url: recent, visits: [{ date: new Date(now - 5000) }] },
+  ]);
+
+  const { component } = await showHistorySidebar();
+  const { controller } = component;
+  const shown = url =>
+    Array.from(component.lists).some(list =>
+      list.tabItems.some(item => item.url === url)
+    );
+  const waitForRows = predicate =>
+    TestUtils.waitForCondition(() => !controller.isHistoryPending && predicate());
+
+  const { HistoryDateRegistry } = ChromeUtils.importESModule(
+    "moz-src:///browser/components/places/history/HistoryDateRegistry.sys.mjs"
+  );
+  const staleRegistry = await HistoryDateRegistry.create();
+  const pending = Promise.withResolvers();
+  const sandbox = sinon.createSandbox();
+  try {
+    await waitForRows(() => shown(recent) && shown(older));
+    const create = sandbox.stub(HistoryDateRegistry, "create").callThrough();
+    create.onFirstCall().returns(pending.promise);
+    const oldRefresh = controller.updateCache();
+
+    await PlacesUtils.history.removeVisitsByFilter({
+      beginDate: new Date(now - hour),
+    });
+    await waitForRows(() => !shown(recent) && shown(older));
+    const refreshed = controller.historyCache;
+    pending.resolve(staleRegistry);
+    await oldRefresh;
+    Assert.equal(controller.historyCache, refreshed, "Do not publish old reads");
+
+    controller.onSearchQuery({ detail: { query: "sidebar-history" } });
+    await waitForRows(() => Boolean(controller.searchResults) && shown(older));
+    await PlacesUtils.history.clear();
+    await waitForRows(() => !shown(older));
+    Assert.deepEqual(controller.searchResults, [], "Drop cleared search matches");
+    Assert.equal(controller.searchQuery, "sidebar-history", "Keep the query");
+  } finally {
+    sandbox.restore();
+    pending.resolve(staleRegistry);
+    SidebarTestUtils.closePanel(window);
+  }
+});
