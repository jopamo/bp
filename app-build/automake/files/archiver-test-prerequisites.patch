--- a/t/dist-tar-fails.sh
+++ b/t/dist-tar-fails.sh
@@ -73,7 +73,7 @@
 ./configure
 
 for fake_tar in tar-fails tar-warns; do
-  run_make -M -e FAIL dist am__tar=./$fake_tar
+  run_make -M -e FAIL dist am__tar=./$fake_tar AM_DIST_TAR_IGNORE_STDERR=no
   grep 'cannot archive that' output
