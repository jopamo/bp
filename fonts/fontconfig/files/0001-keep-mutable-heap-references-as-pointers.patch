From: Paul Moses <p@1g4.org>
Subject: [PATCH] fontconfig: keep mutable heap references as pointers

Mutable patterns and charsets store heap references as relative offsets.
LeakSanitizer cannot follow those offsets and reports allocations owned by
reachable objects as leaked. Explicit destruction releases the allocations.

Store absolute addresses for mutable objects. Keep offsets for constant
objects, including serialized caches and frozen charsets. The structure
layouts and serialized offset representation remain unchanged. Charset
array growth no longer needs to rebase references to separately allocated
leaves.

Add a regression that checks reachability and destruction under ASan,
including charset array growth.

Base: fontconfig ebec29cb759cca828c3ffc043033f470e0af8367

diff --git a/src/fcint.h b/src/fcint.h
--- a/src/fcint.h
+++ b/src/fcint.h
@@ -233,11 +233,12 @@
 struct _FcPattern {
     int      num;
     int      size;
-    intptr_t elts_offset;
+    intptr_t elts_offset; /* Offset for constant patterns, pointer otherwise. */
     FcRef    ref;
 };
 
-#define FcPatternElts(p)     FcOffsetMember (p, elts_offset, FcPatternElt)
+#define FcPatternElts(p)     (FcRefIsConst (&(p)->ref) ? FcOffsetMember (p, elts_offset, FcPatternElt) \
+                                                    : (FcPatternElt *)(p)->elts_offset)
 
 #define FcFontSetFonts(fs)   FcPointerMember (fs, fonts, FcPattern *)
 
@@ -405,15 +406,19 @@
 struct _FcCharSet {
     FcRef    ref; /* reference count */
     int      num; /* size of leaves and numbers arrays */
+    /* Offsets for constant charsets, pointers otherwise. */
     intptr_t leaves_offset;
     intptr_t numbers_offset;
 };
 
-#define FcCharSetLeaves(c)           FcOffsetMember (c, leaves_offset, intptr_t)
-#define FcCharSetLeaf(c, i)          (FcOffsetToPtr (FcCharSetLeaves (c),    \
-                                                     FcCharSetLeaves (c)[i], \
-                                                     FcCharLeaf))
-#define FcCharSetNumbers(c)          FcOffsetMember (c, numbers_offset, FcChar16)
+#define FcCharSetLeaves(c)           (FcRefIsConst (&(c)->ref) ? FcOffsetMember (c, leaves_offset, intptr_t) \
+                                                            : (intptr_t *)(c)->leaves_offset)
+#define FcCharSetLeaf(c, i)          (FcRefIsConst (&(c)->ref) ? FcOffsetToPtr (FcCharSetLeaves (c), \
+                                                                             FcCharSetLeaves (c)[i], \
+                                                                             FcCharLeaf) \
+                                                            : (FcCharLeaf *)FcCharSetLeaves (c)[i])
+#define FcCharSetNumbers(c)          (FcRefIsConst (&(c)->ref) ? FcOffsetMember (c, numbers_offset, FcChar16) \
+                                                            : (FcChar16 *)(c)->numbers_offset)
 
 #define FCSS_DEFAULT                 0 /* default behavior */
 #define FCSS_ALLOW_DUPLICATES        1 /* allows for duplicate strings in the set */
diff --git a/src/fcpat.c b/src/fcpat.c
--- a/src/fcpat.c
+++ b/src/fcpat.c
@@ -41,7 +41,7 @@
     memset (p, 0, sizeof (FcPattern));
     p->num = 0;
     p->size = 0;
-    p->elts_offset = FcPtrToOffset (p, NULL);
+    p->elts_offset = 0;
     FcRefInit (&p->ref, 1);
     return p;
 }
@@ -514,7 +514,7 @@
 		e = (FcPatternElt *)malloc (s * sizeof (FcPatternElt));
 	    if (!e)
 		return FcFalse;
-	    p->elts_offset = FcPtrToOffset (p, e);
+	    p->elts_offset = (intptr_t)e;
 	    while (p->size < s) {
 		e[p->size].object = 0;
 		e[p->size].values = NULL;
diff --git a/src/fccharset.c b/src/fccharset.c
--- a/src/fccharset.c
+++ b/src/fccharset.c
@@ -166,9 +166,7 @@
 		return FcFalse;
 	    }
 	} else {
-	    int          i;
 	    unsigned int alloced = fcs->num;
-	    uintptr_t    old_leaves = (uintptr_t)leaves;
 	    intptr_t    *new_leaves;
 
 	    alloced *= 2;
@@ -181,24 +179,19 @@
 		 * Revert the reallocation of numbers. We update numbers_offset
 		 * first in case realloc() fails.
 		 */
-		fcs->numbers_offset = FcPtrToOffset (fcs, numbers);
+		fcs->numbers_offset = (intptr_t)numbers;
 		numbers = realloc (numbers, (alloced / 2) * sizeof (*numbers));
 		/* unlikely to fail though */
 		if (!numbers)
 		    return FcFalse;
-		fcs->numbers_offset = FcPtrToOffset (fcs, numbers);
+		fcs->numbers_offset = (intptr_t)numbers;
 		return FcFalse;
 	    }
-	    for (i = 0; i < fcs->num; i++) {
-		// Reconstruct FcCharLeaf* from offset, similar to how FcCharSetLeaf() macro operates
-		FcCharLeaf *leaf = FcOffsetToPtr (old_leaves, new_leaves[i], FcCharLeaf);
-		new_leaves[i] = FcPtrToOffset (new_leaves, leaf);
-	    }
 	    leaves = new_leaves;
 	}
 
-	fcs->leaves_offset = FcPtrToOffset (fcs, leaves);
-	fcs->numbers_offset = FcPtrToOffset (fcs, numbers);
+	fcs->leaves_offset = (intptr_t)leaves;
+	fcs->numbers_offset = (intptr_t)numbers;
     }
 
     memmove (leaves + pos + 1, leaves + pos,
@@ -206,7 +199,7 @@
     memmove (numbers + pos + 1, numbers + pos,
              (fcs->num - pos) * sizeof (*numbers));
     numbers[pos] = (FcChar16)ucs4;
-    leaves[pos] = FcPtrToOffset (leaves, leaf);
+    leaves[pos] = (intptr_t)leaf;
     fcs->num++;
     return FcTrue;
 }
