+// Use a loopback leaf signed by a test CA instead of a public endpoint with rotating pins.
+func signedPinServer(t *testing.T) *httptest.Server {
+	t.Helper()
+	ca, err := certs.NewTLSTemplate()
+	r.NoError(t, err)
+	certPEM, keyPEM, err := certs.GenerateCert(ca)
+	r.NoError(t, err)
+	issuer, err := tls.X509KeyPair(certPEM, keyPEM)
+	r.NoError(t, err)
+	parent, err := x509.ParseCertificate(issuer.Certificate[0])
+	r.NoError(t, err)
+	leaf, err := certs.NewTLSTemplate()
+	r.NoError(t, err)
+	leaf.IsCA = false
+	leaf.KeyUsage = x509.KeyUsageDigitalSignature
+	leaf.Subject.CommonName = "pin-test leaf"
+	pub, key, err := ed25519.GenerateKey(rand.Reader)
+	r.NoError(t, err)
+	der, err := x509.CreateCertificate(rand.Reader, leaf, parent, pub, issuer.PrivateKey)
+	r.NoError(t, err)
+	srv := httptest.NewUnstartedServer(nil)
+	srv.TLS = &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der, issuer.Certificate[0]}, PrivateKey: key}}}
+	srv.StartTLS()
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+func serverPin(srv *httptest.Server) string {
+	sum := sha256.Sum256(srv.Certificate().RawSubjectPublicKeyInfo)
+	return `pin-sha256="` + base64.StdEncoding.EncodeToString(sum[:]) + `"`
+}
+
