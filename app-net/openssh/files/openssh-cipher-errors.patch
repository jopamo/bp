Honor boolean EVP_Cipher failure for ordinary ciphers without treating the
zero-byte success of custom GCM finalization as failure. Reject mismatched
authentication-tag extents before packet processing.

--- a/cipher.c
+++ b/cipher.c
@@ -340 +340 @@
- * Both 'aadlen' and 'authlen' can be set to 0.
+ * 'aadlen' may be 0; 'authlen' must match the cipher's tag length.
@@ -345,0 +346,6 @@
+#ifdef WITH_OPENSSL
+	int ret;
+#endif
+
+	if (authlen != cipher_authlen(cc->cipher))
+		return SSH_ERR_INVALID_ARGUMENT;
@@ -367,2 +372,0 @@
-		if (authlen != cipher_authlen(cc->cipher))
-			return SSH_ERR_INVALID_ARGUMENT;
@@ -387,2 +391,3 @@
-	if (EVP_Cipher(cc->evp, dest + aadlen, (u_char *)src + aadlen,
-	    len) < 0)
+	ret = EVP_Cipher(cc->evp, dest + aadlen, (u_char *)src + aadlen, len);
+	/* GCM returns a byte count; ordinary ciphers return a boolean. */
+	if (ret < 0 || (authlen == 0 && ret == 0))
