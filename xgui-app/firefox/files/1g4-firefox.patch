+add_task(async function test_csp_blocked_favicon() {
+  const markup = `<meta http-equiv="Content-Security-Policy" content="img-src 'none'">`;
+  const pageURL =
+    "https://example.com/document-builder.sjs?html=" +
+    encodeURIComponent(markup);
+  const iconURL =
+    "https://example.com/browser/browser/base/content/test/browser-favicons/file_favicon.png?csp";
+
+  await BrowserTestUtils.withNewTab(pageURL, async browser => {
+    const failedIcon = waitForFaviconMessage(true, iconURL).then(
+      () => null,
+      failure => failure.iconURL
+    );
+    const blockedURL = await SpecialPowers.spawn(
+      browser,
+      [iconURL],
+      async href => {
+        const doc = content.document;
+        const blocked = ContentTaskUtils.waitForEvent(
+          doc,
+          "securitypolicyviolation",
+          false,
+          event =>
+            event.effectiveDirective === "img-src" && event.blockedURI === href
+        );
+        const icon = doc.createElement("link");
+        icon.rel = "icon";
+        icon.href = href;
+        doc.head.appendChild(icon);
+        return (await blocked).blockedURI;
+      }
+    );
+    Assert.equal(blockedURL, iconURL, "CSP reports the favicon block");
+    Assert.equal(await failedIcon, iconURL, "The favicon was not loaded");
+
+    const duplicateLog = await SpecialPowers.spawn(browser, [], () =>
+      Cc["@mozilla.org/consoleAPI-storage;1"]
+        .getService(Ci.nsIConsoleAPIStorage)
+        .getEvents()
+        .some(
+          event =>
+            event.level === "error" &&
+            event.filename.endsWith("/FaviconLoader.sys.mjs") &&
+            event.arguments.some(
+              arg => arg?.result === Cr.NS_ERROR_CONTENT_BLOCKED
+            )
+        )
+    );
+    Assert.ok(!duplicateLog, "The favicon loader does not also log an error");
+  });
+});
