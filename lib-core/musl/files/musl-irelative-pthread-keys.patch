+static void reloc_finalize(struct dso *p)
+{
+	if (p->relocated) return;
+	if (head != &ldso && p->relro_start != p->relro_end) {
+		long ret = __syscall(SYS_mprotect, laddr(p, p->relro_start),
+			p->relro_end-p->relro_start, PROT_READ);
+		if (ret != 0 && ret != -ENOSYS) {
+			set_errno(-ret);
+			error("Error relocating %s: RELRO protection failed: %m",
+				p->name);
+			if (runtime) longjmp(*rtld_fail, 1);
+		}
@@ -1439,0 +1495,10 @@ static void reloc_all(struct dso *p)
+	p->relocated = 1;
+}
+
+static void reloc_all(struct dso *p)
+{
+	struct dso *q;
+	for (q=p; q; q=q->next) reloc_regular(q);
+	if (!ldd_mode && head != &ldso)
+		for (q=p; q; q=q->next) reloc_irelative(q);
+	for (q=p; q; q=q->next) reloc_finalize(q);
@@ -1763,0 +1829,2 @@ hidden void __dls2(unsigned char *base, size_t *sp)
+	ldso.relocs_done = 0;
+	ldso.irelative_done = 0;
@@ -2032,2 +2099,8 @@ void __dls3(size_t *sp, size_t *auxv)
-	reloc_all(app.next);
-	reloc_all(&app);
+	for (struct dso *p=app.next; p; p=p->next) reloc_regular(p);
+	reloc_regular(&app);
+	if (!ldd_mode) {
+		for (struct dso *p=app.next; p; p=p->next) reloc_irelative(p);
+		reloc_irelative(&app);
+	}
+	for (struct dso *p=app.next; p; p=p->next) reloc_finalize(p);
+	reloc_finalize(&app);
