+add_task(async function test_fetch_success_stays_in_its_document() {
+  await BrowserTestUtils.withNewTab(
+    "https://example.com/browser/toolkit/components/passwordmgr/test/browser/empty.html",
+    async browser => {
+      await SpecialPowers.spawn(browser, [], async () => {
+        const doc = content.document;
+        const frame = doc.createElement("iframe");
+        frame.srcdoc = "<!doctype html>";
+        const loaded = ContentTaskUtils.waitForEvent(frame, "load");
+        doc.body.appendChild(frame);
+        await loaded;
+        const frameWindow = frame.contentWindow;
+        const topActor = content.windowGlobalChild.getActor("FormHandler");
+        const frameActor = frameWindow.windowGlobalChild.getActor("FormHandler");
+        topActor.registerFormSubmissionInterest(topActor);
+        frameActor.registerFormSubmissionInterest(frameActor);
+
+        let topNotifications = 0;
+        let frameNotifications = 0;
+        doc.addEventListener("before-form-submission", () => topNotifications++);
+        frameWindow.document.addEventListener(
+          "before-form-submission",
+          () => frameNotifications++
+        );
+
+        const frameNotification = ContentTaskUtils.waitForEvent(
+          frameWindow.document,
+          "before-form-submission"
+        );
+        await frameWindow.fetch(doc.URL);
+        await frameNotification;
+        Assert.equal(frameNotifications, 1, "The fetching document is notified");
+        Assert.equal(topNotifications, 0, "The other document is not notified");
+
+        const topNotification = ContentTaskUtils.waitForEvent(
+          doc,
+          "before-form-submission"
+        );
+        await content.fetch(doc.URL);
+        await topNotification;
+        Assert.equal(
+          topNotifications,
+          1,
+          "The top document can still be notified"
+        );
+        Assert.equal(frameNotifications, 1, "The frame is not notified again");
+      });
+
+      // A pending notification can lose its browsing context on frame removal.
+      const actor = browser.browsingContext.currentWindowGlobal.getActor(
+        "FormHandler"
+      );
+      actor.receiveMessage({
+        name: "FormHandler:NotifyNavigatedSubtree",
+        data: null,
+      });
+    }
+  );
+});
