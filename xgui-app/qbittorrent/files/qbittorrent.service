[Unit]
Description=qBittorrent Daemon Service
After=network.target
StartLimitIntervalSec=1min
StartLimitBurst=3

[Service]
User=qbittorrent
Group=qbittorrent
Type=simple
ExecStart=/usr/bin/qbittorrent-nox
Restart=on-failure
RestartSec=30s
# Do not retry indefinitely when the configured service account is absent.
RestartPreventExitStatus=217
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=full
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
