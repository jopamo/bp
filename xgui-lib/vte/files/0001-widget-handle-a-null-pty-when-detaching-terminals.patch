From 8c9137f625d281683078d777a067bf4a708e7ca6 Mon Sep 17 00:00:00 2001
From: Paul Moses <p@1g4.org>
Date: Thu, 1 Oct 2026 15:40:05 -0500
Subject: [PATCH] widget: handle a null pty when detaching terminals

vte_terminal_set_pty() accepts NULL to detach a terminal's PTY, but
Widget::set_pty() passes the cleared wrapper to _vte_pty_get_impl(),
which dereferences it. Attaching a PTY and then unsetting it crashes.
This also occurs when an asynchronous terminal spawn fails.

Pass nullptr directly to Terminal::set_pty() when the wrapper is empty.
Keep _vte_pty_get_impl()'s non-null contract unchanged.

Add GTK 3 and GTK 4 regression tests for attach, detach, repeated setters,
reattach, property-based detach, notifications, and PTY finalization.
Skip the widget tests when no display is available.

Fixes: 8c72345d1df5 ("pty: Separate PTY code from its GObject wrapper")
---
 src/meson.build    | 15 ++++++++
 src/widget-test.cc | 90 ++++++++++++++++++++++++++++++++++++++++++++++
 src/widget.cc      |  2 +-
 3 files changed, 106 insertions(+), 1 deletion(-)
 create mode 100644 src/widget-test.cc

diff --git a/src/meson.build b/src/meson.build
index f8556d7..6c44bf7 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -1097,6 +1097,21 @@ if get_option('gtk3')
   test_units += [test_vtetypes,]
 endif
 
+foreach gtk: ['3', '4']
+  if get_option('gtk' + gtk)
+    test_widget = executable(
+      'test-widget-gtk' + gtk,
+      sources: config_sources + files('widget-test.cc'),
+      dependencies: [get_variable('libvte_gtk' + gtk + '_dep')],
+      cpp_args: ['-DVTE_GTK=' + gtk],
+      include_directories: top_inc,
+      install: false,
+    )
+
+    test_units += [test_widget,]
+  endif
+endforeach
+
 # Run unit tests
 
 test_env = [
diff --git a/src/widget-test.cc b/src/widget-test.cc
new file mode 100644
index 0000000..2f7e541
--- /dev/null
+++ b/src/widget-test.cc
@@ -0,0 +1,90 @@
