+add_task(async function test_cancelled_load_does_not_forget_its_replacement() {
+  await SpecialPowers.pushPrefEnv({
+    set: [["browser.chrome.guess_favicon", false]],
+  });
+  const thirdRequested = Promise.withResolvers();
+  registerCleanupFunction(() => thirdRequested.resolve());
+  XPCShellContentUtils.ensureInitialized(this);
+  const server = XPCShellContentUtils.createHttpServer();
+  const origin = `http://localhost:${server.identity.primaryPort}`;
+  server.registerPathHandler("/page", (request, response) => {
+    response.setHeader("Content-Type", "text/html");
+    response.write("<title>Icon replacement test</title>");
+  });
+
+  const paths = ["/first.svg", "/second.svg", "/third.svg"];
+  function writeIcon(response) {
+    response.setHeader("Content-Type", "image/svg+xml");
+    response.write(
+      '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"/>'
+    );
+  }
+  server.registerPathHandler(paths[0], (request, response) => writeIcon(response));
+  server.registerPathHandler(paths[1], (request, response) => {
+    response.processAsync();
+    // The second load must still be pending when the third load starts.
+    thirdRequested.promise.then(() => {
+      writeIcon(response);
+      response.finish();
+    });
+  });
+  server.registerPathHandler(paths[2], (request, response) => {
+    writeIcon(response);
+    thirdRequested.resolve();
+  });
+
+  await BrowserTestUtils.withNewTab(origin + "/page", async browser => {
+    const applied = await SpecialPowers.spawn(browser, [paths], async paths => {
+      const { FaviconLoader } = ChromeUtils.importESModule(
+        "resource:///modules/FaviconLoader.sys.mjs"
+      );
+      const loaded = [];
+      const { tabIconLoader } = new FaviconLoader({
+        sendAsyncMessage(name, data) {
+          if (name === "Link:SetIcon") {
+            loaded.push(new URL(data.originalURL).pathname);
+          }
+        },
+      });
+      const node = content.document;
+      const load = path =>
+        tabIconLoader.load({
+          iconUri: SpecialPowers.Services.io.newURI(
+            path,
+            null,
+            node.documentURIObject
+          ),
+          node,
+          isTabIcon: true,
+        });
+
+      const first = load(paths[0]);
+      const second = load(paths[1]);
+      // Let the first load's cancellation settle before replacing the second.
+      await first;
+      await Promise.all([second, load(paths[2])]);
+      return loaded;
+    });
+    Assert.deepEqual(applied, ["/third.svg"], "Only the last load sets an icon");
+  });
+});
