+void TestImports::testOPUXInvalid()
+{
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    const auto path = dir.filePath("invalid.1pux");
+    const QByteArray payload(R"({"accounts":[]})");
+    auto archive = zip_open(QFile::encodeName(path).constData(), ZIP_CREATE | ZIP_TRUNCATE, nullptr);
+    QVERIFY(archive);
+    auto source = zip_source_buffer(archive, payload.constData(), payload.size(), 0);
+    QVERIFY(source);
+    const auto index = zip_file_add(archive, "other.data", source, 0);
+    QVERIFY(index >= 0);
+    QCOMPARE(zip_set_file_compression(archive, index, ZIP_CM_STORE, 0), 0);
+    QCOMPARE(zip_close(archive), 0);
+
+    OPUXReader reader;
+    QVERIFY(!reader.convert(path));
+    QVERIFY(reader.hasError());
+
+    archive = zip_open(QFile::encodeName(path).constData(), 0, nullptr);
+    QVERIFY(archive);
+    QCOMPARE(zip_file_rename(archive, 0, "export.data", 0), 0);
+    QCOMPARE(zip_close(archive), 0);
+
+    QFile file(path);
+    QVERIFY(file.open(QIODevice::ReadWrite));
+    auto bytes = file.readAll();
+    const auto offset = bytes.indexOf(payload);
+    QVERIFY(offset >= 0);
+    QVERIFY(file.seek(offset));
+    QCOMPARE(file.write("!", 1), 1);
+    file.close();
+    QVERIFY(!reader.convert(path));
+    QVERIFY(reader.hasError());
+
+    QVERIFY(file.open(QIODevice::WriteOnly | QIODevice::Truncate));
+    QCOMPARE(file.write("not a zip archive"), 17);
+    file.close();
+    QVERIFY(!reader.convert(path));
+    QVERIFY(reader.hasError());
+}
