+#define KMP_VERSION_OMPC_SYMBOL(apic_name, api_name, ver_num, ver_str)         \
+  _KMP_VERSION_OMPC_SYMBOL(apic_name, api_name, ver_num, ver_str, "VERSION")
+#if defined(__GNUC__) && !defined(__clang__) && __GNUC__ >= 10
+// Expose the versioned names to GCC's LTO symbol table, not only to the assembler.
+#define _KMP_SYMVER_IMPL(fn, public_name, ver_num, ver_str, default_ver)       \
+  __typeof__(__kmp_api_##fn) __kmp_api_##fn##_##ver_num##_alias              \
+      __attribute__((alias(KMP_STR(__kmp_api_##fn)),                          \
+                     symver(KMP_STR(public_name) "@" ver_str)));              \
+  __typeof__(__kmp_api_##fn) __kmp_api_##fn                                   \
+      __attribute__((symver(KMP_STR(fn) "@@" default_ver)))
+
+#define _KMP_VERSION_SYMBOL(api_name, ver_num, ver_str, default_ver)          \
+  _KMP_SYMVER_IMPL(api_name, api_name, ver_num, ver_str, default_ver)
+#define _KMP_VERSION_OMPC_SYMBOL(apic_name, api_name, ver_num, ver_str,         \
+                                 default_ver)                                 \
+  _KMP_SYMVER_IMPL(apic_name, api_name, ver_num, ver_str, default_ver)
+#else
