@@ -0,0 +1,131 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+body {
+  margin: 0;
+  color: CanvasText;
+  background: Canvas;
+  font-family: system-ui, sans-serif;
+}
+
+main {
+  max-inline-size: 41rem;
+  margin: clamp(2rem, 14vh, 7rem) auto 2rem;
+  padding-inline: 1rem;
+}
+
+header {
+  margin-block-end: 1.5rem;
+  text-align: center;
+}
+
+h1,
+p {
+  margin: 0;
+}
+
+h1 {
+  font-size: clamp(1.5rem, 1.1rem + 2vw, 2.25rem);
+  font-weight: 650;
+}
+
+p {
+  margin-block-start: 0.375rem;
+  color: color-mix(in srgb, CanvasText 72%, Canvas);
+  font-size: 0.875rem;
+  line-height: 1.5;
+}
+
+ul {
+  display: grid;
+  grid-template-columns: repeat(
+    auto-fit,
+    minmax(min(100%, 8rem), min(100%, 9.5rem))
+  );
+  justify-content: center;
+  gap: 0.75rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+a {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  justify-items: center;
+  gap: 0.625rem;
+  padding: 0.875rem 0.625rem 0.75rem;
+  border: 1px solid color-mix(in srgb, CanvasText 14%, Canvas);
+  border-radius: 1rem;
+  background: color-mix(in srgb, CanvasText 4%, Canvas);
+  color: inherit;
+  text-decoration: none;
+}
+
+a:hover {
+  background: color-mix(in srgb, CanvasText 8%, Canvas);
+  text-decoration: underline;
+}
+
+a:focus-visible {
+  outline: 2px solid AccentColor;
+  outline-offset: 2px;
+}
+
+.site-icon {
+  display: grid;
+  place-items: center;
+  inline-size: 3.25rem;
+  block-size: 3.25rem;
+  border-radius: 0.875rem;
+  background: light-dark(#dce8fb, #253753);
+  color: light-dark(#254675, #d4e5ff);
+  font-size: 1.375rem;
+  font-weight: 650;
+}
+
+.site-icon[data-tint="1"] {
+  background: light-dark(#d9eee6, #213e36);
+  color: light-dark(#215544, #c6f1df);
+}
+
+.site-icon[data-tint="2"] {
+  background: light-dark(#efe1f6, #402c4c);
+  color: light-dark(#623879, #f0d7ff);
+}
+
+.site-icon[data-tint="3"] {
+  background: light-dark(#f7e8cf, #463621);
+  color: light-dark(#66451d, #ffe4bb);
+}
+
+.site-icon.has-icon {
+  background: color-mix(in srgb, CanvasText 8%, Canvas);
+}
+
+.site-icon img {
+  inline-size: 2rem;
+  block-size: 2rem;
+  object-fit: contain;
+}
+
+.site-host {
+  max-inline-size: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 0.875rem;
+  font-weight: 550;
+  line-height: 1.5;
+}
+
+@media (forced-colors: active) {
+  a {
+    border-color: ButtonText;
+  }
+
+  a:focus-visible {
+    outline-color: Highlight;
+  }
+}
