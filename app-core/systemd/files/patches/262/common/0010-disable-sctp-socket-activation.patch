--- a/test/units/TEST-23-UNIT-FILE.verify-unit-files.sh
+++ b/test/units/TEST-23-UNIT-FILE.verify-unit-files.sh
@@ -49,3 +49,45 @@

     systemd-analyze --recursive-errors=no --man=no verify "$unit_file"
 done
+
+# Refuse explicit SCTP configurations instead of falling back to TCP.
+work=$(mktemp -d)
+trap 'rm -rf -- "$work"' EXIT
+export SYSTEMD_UNIT_PATH="$work"
+
+cat >"$work/no-sctp.service" <<'UNIT'
+[Unit]
+DefaultDependencies=no
+[Service]
+ExecStart=/bin/true
+UNIT
+
+socket="$work/no-sctp.socket"
+cat >"$socket" <<'UNIT'
+[Unit]
+DefaultDependencies=no
+[Socket]
+ListenStream=127.0.0.1:12345
+UNIT
+
+verify_socket() {
+    systemd-analyze --generators=no --man=no --recursive-errors=no verify "$socket"
+}
+
+reject_sctp() {
+    if verify_socket >"$work/log" 2>&1; then
+        echo 'SCTP socket unit was accepted' >&2
+        exit 1
+    fi
+    grep -F 'SocketProtocol= requests SCTP, which is not supported.' "$work/log"
+}
+
+verify_socket
+mkdir "$socket.d"
+printf '[Socket]\nSocketProtocol=132\n' >"$socket.d/protocol.conf"
+reject_sctp
+rm "$socket.d/protocol.conf"
+printf 'SocketProtocol=sctp\n' >>"$socket"
+reject_sctp
+printf '[Socket]\nSocketProtocol=mptcp\n' >"$socket.d/protocol.conf"
+verify_socket
