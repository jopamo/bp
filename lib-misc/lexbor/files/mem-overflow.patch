diff --git a/test/lexbor/core/mem.c b/test/lexbor/core/mem.c
--- a/test/lexbor/core/mem.c
+++ b/test/lexbor/core/mem.c
@@ -9,6 +9,25 @@
 #include <lexbor/core/mem.h>
 
 
+TEST_BEGIN(align)
+{
+    size_t limit = lexbor_mem_align_floor(SIZE_MAX);
+
+    test_eq_size(lexbor_mem_align(0), 0UL);
+    test_eq_size(lexbor_mem_align(1), LEXBOR_MEM_ALIGN_STEP);
+    test_eq_size(lexbor_mem_align(LEXBOR_MEM_ALIGN_STEP),
+                 LEXBOR_MEM_ALIGN_STEP);
+    test_eq_size(lexbor_mem_align(LEXBOR_MEM_ALIGN_STEP + 1),
+                 2 * LEXBOR_MEM_ALIGN_STEP);
+    test_eq_size(lexbor_mem_align(limit), limit);
+
+    for (size_t i = 1; i <= SIZE_MAX - limit; i++) {
+        test_eq_size(lexbor_mem_align(limit + i), 0UL);
+        test_eq_size(lexbor_mem_align_noi(limit + i), 0UL);
+    }
+}
+TEST_END
+
 TEST_BEGIN(init)
 {
     lexbor_mem_t *mem = lexbor_mem_create();
@@ -308,6 +327,7 @@
