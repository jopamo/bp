Compare localized output with the platform locale data rather than a fixed
list of translations. Musl can accept locale names without installed data,
and musl-locales uses different abbreviations from glibc.

--- a/test/chrono-test.cc
+++ b/test/chrono-test.cc
@@ -783,9 +783,9 @@
   if (loc != std::locale::classic()) {
-    auto saturdays = std::vector<std::string>{"sáb", "sá.", "sáb."};
-    EXPECT_THAT(saturdays, Contains(fmt::format(loc, "{:L}", sat)));
-    EXPECT_THAT(saturdays, Contains(fmt::format(loc, "{:L%a}", sat)));
-    EXPECT_THAT(saturdays, Contains(fmt::format(loc, "{:L%a}", tm)));
+    auto saturday = system_strftime("%a", &tm, &loc);
+    EXPECT_EQ(saturday, fmt::format(loc, "{:L}", sat));
+    EXPECT_EQ(saturday, fmt::format(loc, "{:L%a}", sat));
+    EXPECT_EQ(saturday, fmt::format(loc, "{:L%a}", tm));
     // Without an explicit locale the global one is used.
-    EXPECT_THAT(saturdays, Contains(fmt::format("{:L}", sat)));
-    EXPECT_THAT(saturdays, Contains(fmt::format("{:L%a}", tm)));
+    EXPECT_EQ(saturday, fmt::format("{:L}", sat));
+    EXPECT_EQ(saturday, fmt::format("{:L%a}", tm));
   }
@@ -1176,6 +1176,8 @@
   if (loc != std::locale::classic()) {
-    auto months = std::vector<std::string>{"ene.", "ene"};
-    EXPECT_THAT(months, Contains(fmt::format(loc, "{:L}", month)));
-    EXPECT_THAT(months, Contains(fmt::format(loc, "{:L%b}", month)));
-    EXPECT_THAT(months, Contains(fmt::format("{:L}", month)));
+    auto tm = std::tm();
+    tm.tm_mon = 0;
+    auto january = system_strftime("%b", &tm, &loc);
+    EXPECT_EQ(january, fmt::format(loc, "{:L}", month));
+    EXPECT_EQ(january, fmt::format(loc, "{:L%b}", month));
+    EXPECT_EQ(january, fmt::format("{:L}", month));
   }
