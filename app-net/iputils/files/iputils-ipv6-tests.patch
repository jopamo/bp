--- a/test/lib.pl
+++ b/test/lib.pl
@@ -3,6 +3,28 @@
 # Copyright (c) 2025 Petr Vorel <pvorel@suse.cz>
 
 our @EXPORT_OK = qw(get_cmd);
+
+sub skip_ipv6
+{
+	return 1 if $ENV{SKIP_IPV6};
+
+	require Socket;
+	require Errno;
+	my $socket;
+	if (!socket($socket, Socket::AF_INET6(), Socket::SOCK_DGRAM(), 0)) {
+		return 1 if $! == Errno::EAFNOSUPPORT();
+		die "IPv6 socket: $!\n";
+	}
+	my $addr = Socket::sockaddr_in6(0, Socket::inet_pton(Socket::AF_INET6(), '::1'));
+	if (!bind($socket, $addr)) {
+		my $error = 0 + $!;
+		close($socket);
+		return 1 if $error == Errno::EADDRNOTAVAIL();
+		die "IPv6 loopback bind: $error\n";
+	}
+	close($socket);
+	return 0;
+}
 
