target/i386/tcg: load only active lanes of AVX masked loads

WM preloads the entire memory operand before the helper sees the mask.
Pass the effective address instead. Stage selected lanes before writing
the destination, including when it aliases the mask register.

--- a/target/i386/ops_sse.h
+++ b/target/i386/ops_sse.h
@@ -2339,21 +2339,33 @@
     }
 }

-void glue(helper_vpmaskmovd, SUFFIX)(CPUX86State *env, Reg *d, Reg *v, Reg *s)
-{
-    int i;
-
-    for (i = 0; i < (2 << SHIFT); i++) {
-        d->L(i) = (v->L(i) >> 31) ? s->L(i) : 0;
-    }
-}
-
-void glue(helper_vpmaskmovq, SUFFIX)(CPUX86State *env, Reg *d, Reg *v, Reg *s)
-{
-    int i;
-
-    for (i = 0; i < (1 << SHIFT); i++) {
-        d->Q(i) = (v->Q(i) >> 63) ? s->Q(i) : 0;
+void glue(helper_vpmaskmovd, SUFFIX)(CPUX86State *env, Reg *d, Reg *v,
+                                     target_ulong a0)
+{
+    uint32_t result[2 << SHIFT];
+
+    for (int i = 0; i < ARRAY_SIZE(result); i++) {
+        result[i] = (v->L(i) >> 31) ?
+            cpu_ldl_le_data_ra(env, a0 + i * 4, GETPC()) : 0;
+    }
+    /* Commit the destination only after every selected load succeeds. */
+    for (int i = 0; i < ARRAY_SIZE(result); i++) {
+        d->L(i) = result[i];
+    }
+}
+
+void glue(helper_vpmaskmovq, SUFFIX)(CPUX86State *env, Reg *d, Reg *v,
+                                     target_ulong a0)
+{
+    uint64_t result[1 << SHIFT];
+
+    for (int i = 0; i < ARRAY_SIZE(result); i++) {
+        result[i] = (v->Q(i) >> 63) ?
+            cpu_ldq_le_data_ra(env, a0 + i * 8, GETPC()) : 0;
+    }
+    /* Commit the destination only after every selected load succeeds. */
+    for (int i = 0; i < ARRAY_SIZE(result); i++) {
+        d->Q(i) = result[i];
     }
 }

