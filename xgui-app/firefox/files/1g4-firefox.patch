+function delayTabIcon(browser) {
+  const actor =
+    browser.browsingContext.currentWindowGlobal.getActor("LinkHandler");
+  const bytes = Promise.withResolvers();
+  let decoding = false;
+  const pending = actor.setIconFromLink(gBrowser, browser, {
+    originalURL: TEST_ROOT + "moz.png",
+    canStoreIcon: false,
+    isTabIcon: true,
+    images: [
+      {
+        blob: {
+          bytes() {
+            decoding = true;
+            return bytes.promise;
+          },
+        },
+        format: "RGBA",
+        displayWidth: 1,
+        displayHeight: 1,
+      },
+    ],
+  });
+  Assert.ok(decoding, "The image is still being decoded");
+  return {
+    actor,
+    finish() {
+      bytes.resolve(new Uint8Array([0, 176, 42, 255]));
+      return pending;
+    },
+  };
+}
+
+add_task(async function discard_icon_decoded_after_navigation() {
+  await BrowserTestUtils.withNewTab(TEST_URL, async browser => {
+    const delayed = delayTabIcon(browser);
+    try {
+      const nextURL = TEST_URL + "?next";
+      const loaded = BrowserTestUtils.browserLoaded(browser, false, nextURL);
+      const iconAvailable = waitForFavicon(
+        browser,
+        TEST_ROOT + "file_bug970276_favicon1.ico"
+      );
+      BrowserTestUtils.startLoadingURIString(browser, nextURL);
+      await Promise.all([loaded, iconAvailable]);
+      const tab = gBrowser.getTabForBrowser(browser);
+      const currentIcon = gBrowser.getIcon(tab);
+      await delayed.finish();
+      Assert.equal(gBrowser.getIcon(tab), currentIcon, "Keep the new icon");
+    } finally {
+      await delayed.finish();
+    }
+  });
+});
