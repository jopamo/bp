diff --git a/browser/components/newtab/test/xpcshell/test_LocalTopSites.js b/browser/components/newtab/test/xpcshell/test_LocalTopSites.js
new file mode 100644
index 0000000000000000000000000000000000000000..8a435b83a70d2de95347da1db0c8e5fcc0f8cb60
--- /dev/null
+++ b/browser/components/newtab/test/xpcshell/test_LocalTopSites.js
@@ -0,0 +1,320 @@
+/* Any copyright is dedicated to the Public Domain.
+   https://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+const { AppConstants } = ChromeUtils.importESModule(
+  "resource://gre/modules/AppConstants.sys.mjs"
+);
+const { PlacesUtils } = ChromeUtils.importESModule(
+  "resource://gre/modules/PlacesUtils.sys.mjs"
+);
+const { PlacesTestUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/PlacesTestUtils.sys.mjs"
+);
+const { canShowLocalTopSites, LocalTopSitesParent, readLocalTopSites } =
+  ChromeUtils.importESModule(
+    "moz-src:///browser/components/newtab/LocalTopSites.sys.mjs"
+  );
+
+do_get_profile();
+
+add_task({ skip_if: () => !AppConstants.MOZ_1G4_PRIVACY }, function test_policy() {
+  const redirector = Cc[
+    "@mozilla.org/network/protocol/about;1?what=newtab"
+  ].getService(Ci.nsIAboutModule).wrappedJSObject;
+  const newTabPref = "browser.newtabpage.enabled";
+  const historyPref = "places.history.enabled";
+  const blank = "chrome://browser/content/blanktab.html";
+  const topSites = "chrome://browser/content/local-top-sites.html";
+  function page(spec, privateBrowsingId) {
+    return redirector.get1g4PageURI(Services.io.newURI(spec), {
+      originAttributes: { privateBrowsingId },
+    }).spec;
+  }
+  try {
+    Services.prefs.setBoolPref(newTabPref, true);
+    Services.prefs.setBoolPref(historyPref, true);
+    Assert.equal(page("about:home", 0), topSites, "Normal Home shows sites");
+    Assert.equal(page("about:newtab", 0), topSites, "Normal New Tab shows sites");
+    Assert.equal(page("about:home", 1), blank, "Private Home stays blank");
+    Assert.equal(page("about:newtab", 1), blank, "Private New Tab stays blank");
+    Assert.ok(
+      !canShowLocalTopSites("about:newtab", undefined),
+      "Unknown privacy context is denied"
+    );
+    Assert.ok(
+      !canShowLocalTopSites("about:newtab?other", 0),
+      "Only the intended document is allowed"
+    );
+    Services.prefs.setBoolPref(newTabPref, false);
+    Assert.equal(
+      page("about:newtab", 0),
+      blank,
+      "Blank New Tab setting is honored"
+    );
+    Assert.equal(page("about:home", 0), topSites, "Home can still show sites");
+    Services.prefs.setBoolPref(historyPref, false);
+    Assert.equal(page("about:home", 0), blank, "With history off Home stays blank");
+  } finally {
+    Services.prefs.clearUserPref(newTabPref);
+    Services.prefs.clearUserPref(historyPref);
+  }
+});
+
+add_task(async function test_local_data_and_icons() {
+  const visited = "https://www.example.com/account?secret=example#details";
+  const duplicate = "https://www.example.com/another-page";
+  const noIcon = "https://example.org/private";
+  await PlacesTestUtils.addVisits([visited, duplicate, noIcon]);
+  await PlacesTestUtils.promiseAsyncUpdates();
+  const svg =
+    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><rect width="16" height="16"/></svg>';
+  // The best-ranked page can vary; both pages for this host have the icon.
+  for (const url of [visited, duplicate]) {
+    await PlacesUtils.favicons.setFaviconForPage(
+      Services.io.newURI(url),
+      Services.io.newURI("https://icons.example.net/favicon.svg"),
+      Services.io.newURI("data:image/svg+xml," + encodeURIComponent(svg))
+    );
+  }
+
+  const sites = await readLocalTopSites();
+  Assert.equal(sites.length, 2, "Visited domains are deduplicated");
+  const iconSite = sites.find(site => site.host === "example.com");
+  Assert.equal(iconSite.url, "https://www.example.com", "Only the origin is used");
+  Assert.ok(
+    iconSite.icon.startsWith("data:image/svg+xml;base64,"),
+    "The icon uses database bytes, not its remote URL"
+  );
+  Assert.deepEqual(
+    sites.find(site => site.host === "example.org"),
+    { host: "example.org", url: "https://example.org", icon: null },
+    "A missing favicon leaves a monogram slot"
+  );
+  await PlacesUtils.history.clear();
+  Assert.deepEqual(await readLocalTopSites(), [], "Cleared history yields no tiles");
+});
+
+add_task(async function test_icon_saved_on_a_less_frequent_page() {
+  const origin = "https://example.net:8443";
+  const frequent = `${origin}/frequent?private=1`;
+  const withIcon = `${origin}/with-icon`;
+  await PlacesTestUtils.addVisits([
+    { uri: withIcon, visitDate: Date.now() * 1000 - 86400 * 1000000 },
+    { uri: frequent, transition: PlacesUtils.history.TRANSITION_TYPED },
+  ]);
+  await PlacesTestUtils.promiseAsyncUpdates();
+
+  const svg =
+    '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"><circle cx="16" cy="16" r="16"/></svg>';
+  await PlacesUtils.favicons.setFaviconForPage(
+    Services.io.newURI(withIcon),
+    Services.io.newURI(`${origin}/icons/custom.svg`),
+    Services.io.newURI("data:image/svg+xml," + encodeURIComponent(svg))
+  );
+  Assert.equal(
+    await PlacesUtils.favicons.getFaviconForPage(Services.io.newURI(frequent)),
+    null,
+    "The higher-ranked page does not have its own or a root favicon"
+  );
+  const { NewTabUtils } = ChromeUtils.importESModule(
+    "resource://gre/modules/NewTabUtils.sys.mjs"
+  );
+  const [top] = await NewTabUtils.activityStreamLinks.getTopSites({
+    onePerDomain: false,
+    includeFavicon: false,
+    topsiteFrecency: 1,
+  });
+  Assert.equal(top.url, frequent, "The iconless page is ranked first");
+  const saved = await PlacesUtils.favicons.getFaviconForPage(
+    Services.io.newURI(withIcon)
+  );
+  Assert.deepEqual(
+    await readLocalTopSites(),
+    [{ host: "example.net", url: origin, icon: saved.dataURI.spec }],
+    "The site uses the sibling page's saved bytes and retains the original port"
+  );
+  await PlacesUtils.history.clear();
+});
+
+add_task(
+  { skip_if: () => !AppConstants.MOZ_1G4_PRIVACY },
+  async function test_live_icon_updates() {
+    const origin = "https://example.com";
+    const page = `${origin}/visited`;
+    const unrelated = "https://elsewhere.example/path";
+
+    class TestParent extends LocalTopSitesParent {
+      get manager() {
+        return {
+          isClosed: false,
+          isCurrentGlobal: true,
+          documentURI: Services.io.newURI("about:home"),
+        };
+      }
+
+      get browsingContext() {
+        return { originAttributes: { privateBrowsingId: 0 } };
+      }
+
+      messages = [];
+
+      sendAsyncMessage(name) {
+        this.messages.push(name);
+      }
+    }
+    const parent = new TestParent();
+    const read = name => parent.receiveMessage({ name, data: { url: unrelated } });
+    try {
+      Assert.deepEqual(await read("GetIcons"), [], "No candidate set yet");
+      Assert.deepEqual(await read("GetSites"), [], "No history yet");
+      await PlacesTestUtils.addVisits(page);
+      await PlacesTestUtils.promiseAsyncUpdates();
+      Assert.deepEqual(
+        parent.messages.splice(0),
+        ["Refresh"],
+        "The first recorded visit refreshes an open empty page"
+      );
+      const emptyTile = { host: "example.com", url: origin, icon: null };
+      Assert.deepEqual(await read("GetSites"), [emptyTile], "Start with no icon");
+
+      const svg =
+        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"/>';
+      async function saveIcon(url) {
+        await PlacesUtils.favicons.setFaviconForPage(
+          Services.io.newURI(url),
+          Services.io.newURI(new URL("/saved.svg", url).href),
+          Services.io.newURI("data:image/svg+xml," + encodeURIComponent(svg))
+        );
+      }
+
+      await PlacesTestUtils.addVisits(unrelated);
+      await saveIcon(unrelated);
+      Assert.deepEqual(
+        parent.messages,
+        [],
+        "An already populated grid does not rearrange on new visits"
+      );
+      await saveIcon(page);
+      Assert.deepEqual(parent.messages.splice(0), ["IconsChanged"]);
+      const saved = await PlacesUtils.favicons.getFaviconForPage(
+        Services.io.newURI(page)
+      );
+      Assert.deepEqual(
+        await read("GetIcons"),
+        [{ ...emptyTile, icon: saved.dataURI.spec }],
+        "Refresh only the displayed site's saved bytes, ignoring the IPC payload"
+      );
+
+      await PlacesTestUtils.clearFavicons();
+      Assert.deepEqual(parent.messages.splice(0), ["IconsChanged"]);
+      Assert.deepEqual(await read("GetIcons"), [emptyTile], "Expired icon is gone");
+
+      const { NewTabUtils } = ChromeUtils.importESModule(
+        "resource://gre/modules/NewTabUtils.sys.mjs"
+      );
+      const dismissals = NewTabUtils.blockedLinks.prefName;
+      const pendingDismissed = read("GetIcons");
+      NewTabUtils.activityStreamLinks.blockURL({ url: origin + "/" });
+      Assert.deepEqual(await pendingDismissed, [], "Do not publish a dismissed tile");
+      Assert.deepEqual(parent.messages.splice(0), ["Refresh"]);
+      Assert.deepEqual(
+        (await read("GetSites")).map(tile => tile.host),
+        ["elsewhere.example"],
+        "Do not recreate a dismissed destination from a visited subpage"
+      );
+      Services.prefs.clearUserPref(dismissals);
+      Assert.deepEqual(parent.messages.splice(0), ["Refresh"]);
+      Assert.ok(
+        (await read("GetSites")).some(tile => tile.url === origin),
+        "Clearing dismissals refreshes the saved block list"
+      );
+
+      const pending = read("GetIcons");
+      Services.prefs.setBoolPref("places.history.enabled", false);
+      Assert.deepEqual(await pending, [], "Discard a read in flight when revoked");
+      Assert.deepEqual(await read("GetIcons"), [], "History policy gates refreshes");
+      Assert.deepEqual(parent.messages.splice(0), ["Refresh"]);
+      PlacesObservers.notifyListeners([new PlacesRanking()]);
+      Assert.deepEqual(parent.messages, [], "Do not refresh with history off");
+    } finally {
+      parent.didDestroy();
+      Services.prefs.clearUserPref("places.history.enabled");
+      Services.prefs.clearUserPref("browser.newtabpage.blocked");
+      await PlacesUtils.history.clear();
+    }
+  }
+);
+
+add_task(
+  { skip_if: () => !AppConstants.MOZ_1G4_PRIVACY },
+  async function test_private_tab_cannot_change_stored_icon() {
+    const { LinkHandlerParent } = ChromeUtils.importESModule(
+      "resource:///actors/LinkHandlerParent.sys.mjs"
+    );
+    const page = Services.io.newURI("https://example.com/visited");
+    const saved = Services.io.newURI("https://example.com/previous.svg");
+    const data =
+      "data:image/svg+xml;base64," +
+      btoa('<svg xmlns="http://www.w3.org/2000/svg"/>');
+    await PlacesTestUtils.addVisits(page);
+    await PlacesUtils.favicons.setFaviconForPage(
+      page,
+      saved,
+      Services.io.newURI(data)
+    );
+
+    const tab = { removeAttribute() {} };
+    let tabIcon;
+    const gBrowser = {
