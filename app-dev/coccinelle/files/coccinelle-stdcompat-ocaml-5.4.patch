 AC_WITH_OCAML_VERSION([5_3_0], [5.3.0])
+AC_WITH_OCAML_VERSION([5_4_0], [5.4.0])
 
 AS_IF([test "x$target_os_type" = "xWin32"],
   [AC_WITH_BLOCK([WIN32])],
--- a/bundles/stdcompat/stdcompat-current/stdcompat__format_s.mli.in
+++ b/bundles/stdcompat/stdcompat-current/stdcompat__format_s.mli.in
@@ -44,6 +44,9 @@
