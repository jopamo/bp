-	    if (retCd == NULL && interp != NULL) {
-		Tcl_SetObjResult(interp, Tcl_ObjPrintf(
-			"error getting working directory name: %s",
-			Tcl_PosixError(interp)));
+	    if (retCd == NULL) {
+		if (interp != NULL) {
+		    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
+			    "error getting working directory name: %s",
+			    Tcl_PosixError(interp)));
+		}
+		FsUpdateCwd(NULL, NULL);
+		goto cdDidNotChange;
 	    }

 	    if (retCd == tsdPtr->cwdClientData) {
