diff --git a/services/settings/test/unit/test_remote_settings_1g4.js b/services/settings/test/unit/test_remote_settings_1g4.js
new file mode 100644
index 0000000000000000000000000000000000000000..307d2c92c9d5d641e16e0b31345528445079ecc1
--- /dev/null
+++ b/services/settings/test/unit/test_remote_settings_1g4.js
@@ -0,0 +1,67 @@
+/* Any copyright is dedicated to the Public Domain.
+   http://creativecommons.org/publicdomain/zero/1.0/ */
+
+add_task(
+  { skip_if: () => !AppConstants.MOZ_1G4_PRIVACY },
+  async function test_1g4_local_reads_without_remote_settings_network() {
+    const server = new HttpServer();
+    server.start(-1);
+    registerCleanupFunction(() => server.stop(() => {}));
+    const origin = `http://localhost:${server.identity.primaryPort}`;
+    let requests = 0;
+    server.registerPrefixHandler("/", (_request, response) => {
+      ++requests;
+      response.setStatusLine(null, 500, "Remote Settings must stay offline");
+    });
+    Services.prefs.setStringPref("services.settings.server", `${origin}/v2`);
+
+    Assert.ok(Utils.shouldSkipRemoteActivity);
+    Assert.ok(Utils.LOAD_DUMPS);
+
+    for (const name of [
+      "devtools-compatibility-browsers",
+      "devtools-devices",
+      "language-dictionaries",
+    ]) {
+      const client = RemoteSettings(name);
+      const { data } = await SharedUtils.loadJSONDump("main", name);
+      Assert.ok(data.length > 0);
+      Assert.deepEqual(
+        await client.get({ forceSync: true, filters: { id: data[0].id } }),
+        [data[0]]
+      );
+      await client.sync();
+      await client.maybeSync(Date.now());
+      Assert.equal(await client.attachments.cacheAll(true), null);
+    }
+    Assert.deepEqual(
+      await RemoteSettings("urlbar-persisted-search-terms").get({
+        forceSync: true,
+      }),
+      []
+    );
+    const security = RemoteSettings("onecrl", {
+      bucketName: "security-state",
+    });
+    Assert.ok((await security.get({ forceSync: true })).length > 0);
+    await security.sync();
+    await security.maybeSync(Date.now());
+    Assert.equal(await security.attachments.cacheAll(true), null);
+    await Assert.rejects(
+      security.attachments.downloadAsBytes({}),
+      /no remote attachments/
+    );
+    Assert.equal((await RemoteSettings.inspect()).serverTimestamp, null);
+    await RemoteSettings.pollChanges({ full: true });
+    Assert.deepEqual(await RemoteSettings.pullStartupBundle(), []);
+    await Assert.rejects(
+      Utils.fetch(`${origin}/v2/`),
+      /network access is disabled/
+    );
+    Assert.equal(
+      await RemoteSettingsWorker.checkFileHash(`${origin}/file`, 0, ""),
+      false
+    );
+    Assert.equal(requests, 0);
+  }
+);
