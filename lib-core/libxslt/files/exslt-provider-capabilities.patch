+#if defined(EXSLT_CRYPTO_ENABLED) && !defined(_WIN32)
+static int
+exsltCryptoTest(const char *filename, int options) {
+    const char *algorithm;
+
+    if (strcmp(filename, "./hash.1.xsl") == 0) {
+        if (xsltExtModuleFunctionLookup(BAD_CAST "md5",
+                                        EXSLT_CRYPTO_NAMESPACE) == NULL) {
+            fprintf(stderr, "Skipping %s: provider does not offer MD5\n",
+                    filename);
+            return 0;
+        }
+        algorithm = "sha1";
+    } else if (strcmp(filename, "./sha1.1.xsl") == 0)
+        algorithm = "sha1";
+    else if (strcmp(filename, "./crypt.1.xsl") == 0)
+        algorithm = "rc4_encrypt";
+    else
+        return xsltTest(filename, options);
+
+    if (xsltExtModuleFunctionLookup(BAD_CAST algorithm,
+                                    EXSLT_CRYPTO_NAMESPACE) == NULL) {
+        fprintf(stderr, "Skipping %s: provider does not offer %s\n",
+                filename, algorithm);
+        return 0;
+    }
+    return xsltTest(filename, options);
+}
+#endif
