+
+static void reloc_regular(struct dso *p)
+{
+	if (p->relocated || p->relocs_done) return;
+	reloc_dso(p, RELOC_NORMAL);
+	p->relocs_done = 1;
+}
+
+static void reloc_irelative(struct dso *p)
+{
+	size_t i;
+	if (p->relocated || p->irelative_done || p->relocating) return;
+	reloc_regular(p);
+	p->relocating = 1;
+	for (i=0; p->deps && p->deps[i]; i++) {
+		reloc_regular(p->deps[i]);
+		reloc_irelative(p->deps[i]);
+	}
+	reloc_dso(p, RELOC_IRELATIVE);
+	p->irelative_done = 1;
+	p->relocating = 0;
+}
@@ -1438 +1482,12 @@ static void reloc_all(struct dso *p)
