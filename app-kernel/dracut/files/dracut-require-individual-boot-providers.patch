Use dracut-install to select NBD and squash loader providers without BusyBox.

Normalize root ownership inside SquashFS and EROFS when building without root.

--- a/dracut-functions.sh
+++ b/dracut-functions.sh
@@ -1466,6 +1466,18 @@
     return "$_ret"
 }

+# Check the installer closure rather than executing the candidate binaries.
+# This also catches aliases and script interpreters inside a supplied sysroot.
+require_non_busybox_binaries() {
+    local _files _module_name="${moddir##*/}"
+    require_binaries "$@" || return 1
+    _files=$($DRACUT_INSTALL ${dracutsysrootdir:+-r "$dracutsysrootdir"} -n -l -a "$@") || return 1
+    if [[ $'\n'$_files$'\n' == *"/busybox"$'\n'* ]]; then
+        dinfo "Module '${_module_name#[0-9][0-9]}' requires individual providers for: $*"
+        return 1
+    fi
+}
+
 require_any_binary() {
     local _module_name="${moddir##*/}"
     local _ret=1
--- a/modules.d/74nbd/module-setup.sh
+++ b/modules.d/74nbd/module-setup.sh
@@ -11,7 +11,8 @@
         [[ -b /dev/block/$_rootdev ]] || return 1
         check_block_and_slaves block_is_nbd "$_rootdev" || return 255
     }
-    require_binaries nbd-client || return 1
+    # The dracut hooks use -check and -systemd-mark, not supported by BusyBox.
+    require_non_busybox_binaries nbd-client || return 1

     return 0
 }
--- a/modules.d/74squash-erofs/module-setup.sh
+++ b/modules.d/74squash-erofs/module-setup.sh
@@ -18,7 +18,10 @@

 erofs_installpost() {
     local _img="$squashdir/erofs-root.img"
-    local -a _erofs_args
+    local -a _erofs_args=()
+
+    # Match the outer cpio archive when building without root privileges.
+    [[ $EUID == 0 ]] || _erofs_args+=("--all-root")

     # --exclude-path requires a relative path
     _erofs_args+=("--exclude-path=${squashdir#"$initdir"/}")
--- a/modules.d/74squash-squashfs/module-setup.sh
+++ b/modules.d/74squash-squashfs/module-setup.sh
@@ -19,6 +19,10 @@
 squashfs_installpost() {
     local _img="$squashdir/squashfs-root.img"
     local _comp
+    local -a _ownership=()
+
+    # Match the outer cpio archive when building without root privileges.
+    [[ $EUID == 0 ]] || _ownership=(-all-root)

     # shellcheck disable=SC2086
     if [[ $squash_compress ]]; then
@@ -32,7 +36,7 @@
     # shellcheck disable=SC2086
     if ! mksquashfs "$initdir" "$_img" \
         -no-xattrs -no-exports -noappend -no-recovery -always-use-fragments \
-        -no-progress ${_comp:+-comp $_comp} \
+        -no-progress "${_ownership[@]}" ${_comp:+-comp $_comp} \
         -e "$squashdir" 1> /dev/null; then
         dfatal "Failed making squash image"
         exit 1
