Use truncated SHA-256 for the internal glyph-cache key. Vesk rejects plain
SHA-1, which makes HashGlyph() return BadAlloc for RenderAddGlyphs.
The package selects the libcrypto backend; keep the existing 20-byte key.
Reuse one digest context per request and reinitialize it for each glyph.

--- a/Xext/render/glyph.c
+++ b/Xext/render/glyph.c
@@ -28,7 +28,6 @@
 #include "include/mipict.h"
 #include "include/misc.h"
 #include "os/bug_priv.h"
-#include "os/xsha1.h"

 #include "scrnintstr.h"
 #include "os.h"
@@ -165,24 +164,22 @@
 }

 int
-HashGlyph(xGlyphInfo * gi,
+HashGlyph(EVP_MD_CTX *ctx, xGlyphInfo * gi,
           CARD8 *bits, unsigned long size, unsigned char sha1[20])
 {
-    void *ctx = x_sha1_init();
+    unsigned char digest[EVP_MAX_MD_SIZE];
+    unsigned int digest_len = 0;
     int success;

-    if (!ctx)
+    success = EVP_DigestInit_ex(ctx, EVP_sha256(), NULL) &&
+              EVP_DigestUpdate(ctx, gi, sizeof(xGlyphInfo)) &&
+              EVP_DigestUpdate(ctx, bits, size) &&
+              EVP_DigestFinal_ex(ctx, digest, &digest_len);
+    if (!success || digest_len < 20)
         return BadAlloc;

-    success = x_sha1_update(ctx, gi, sizeof(xGlyphInfo));
-    if (!success)
-        return BadAlloc;
-    success = x_sha1_update(ctx, bits, size);
-    if (!success)
-        return BadAlloc;
-    success = x_sha1_final(ctx, sha1);
-    if (!success)
-        return BadAlloc;
+    /* This is an internal cache key, not a protocol SHA-1 value. */
+    memcpy(sha1, digest, 20);
     return Success;
 }

