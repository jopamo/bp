--- a/Makefile
+++ b/Makefile
@@ -2,6 +2,7 @@
 
 include Makefile.configure
 
+PKG_CONFIG ?= pkg-config
 RSYNC	    = rsync
 
 sinclude Makefile.local
@@ -42,27 +43,27 @@
 REGRESS_CU  = regress/cunit/print_7_or_8_bit \
 	      regress/cunit/log_format_type
 
-LDADD_FTS  != pkg-config --libs musl-fts 2>/dev/null || echo ""
-CFLAGS_FTS != pkg-config --cflags musl-fts 2>/dev/null || echo ""
+LDADD_FTS  != $(PKG_CONFIG) --libs musl-fts 2>/dev/null || echo ""
+CFLAGS_FTS != $(PKG_CONFIG) --cflags musl-fts 2>/dev/null || echo ""
 
-LDADD_Z	   != pkg-config --libs zlib 2>/dev/null || echo "-lz"
-CFLAGS_Z   != pkg-config --cflags zlib 2>/dev/null || echo ""
+LDADD_Z	   != $(PKG_CONFIG) --libs zlib 2>/dev/null || echo "-lz"
+CFLAGS_Z   != $(PKG_CONFIG) --cflags zlib 2>/dev/null || echo ""
 
-LDADD_CU   != pkg-config --libs cunit 2>/dev/null || echo ""
-CFLAGS_CU  != pkg-config --cflags cunit 2>/dev/null || echo ""
+LDADD_CU   != $(PKG_CONFIG) --libs cunit 2>/dev/null || echo ""
+CFLAGS_CU  != $(PKG_CONFIG) --cflags cunit 2>/dev/null || echo ""
 
 # FreeBSD has these helpful functions.
 # Darwin does as well on newer builds, but not all, so default to using
 # the compat one unless explicitly given when `configure` is invoked.
 
-.if $(UNAME) == "FreeBSD"
+ifeq ($(UNAME),FreeBSD)
 LDADD	  += -lsbuf
 CFLAGS	  += -DHAVE_SBUF
-.endif
-.if $(UNAME) == "FreeBSD"
+endif
+ifeq ($(UNAME),FreeBSD)
 LDADD	  += -lutil
 CFLAGS	  += -DHAVE_HUMANIZE_NUMBER
-.endif
+endif
 
 CFLAGS	  += $(CFLAGS_FTS) $(CFLAGS_Z)
 LDADD	  += -lm $(LDADD_LIB_SOCKET) $(LDADD_SCAN_SCALED) $(LDADD_Z) $(LDADD_FTS)
