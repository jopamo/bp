+    Assert.ok(await IOUtils.exists(oldArchive), "The old archive was kept");
+  } finally {
+    release.resolve();
+    await holder;
+    await queued;
+    Services.prefs.setBoolPref(SCHEDULED_BACKUPS_ENABLED_PREF_NAME, true);
