Subject: [PATCH] gtypemodule: adapt dynamic type initialization callbacks

Generate exact GInstanceInitFunc and GClassFinalizeFunc adapters while
retaining the typed user callbacks accepted by G_DEFINE_DYNAMIC_TYPE.
Register the adapters without casts and update the expansion example.

Extend the existing C++ smoke test to construct static and dynamic objects,
checking class/instance state, call counts and stable type identities.

diff --git a/gobject/gtypemodule.h b/gobject/gtypemodule.h
--- a/gobject/gtypemodule.h
+++ b/gobject/gtypemodule.h
@@ -134,6 +134,16 @@
  *   gtk_gadget_parent_class = g_type_class_peek_parent (klass); 
  *   gtk_gadget_class_init ((GtkGadgetClass*) klass); 
  * }
+ *
+ * static void gtk_gadget_class_finalize_intern (gpointer klass, gpointer class_data G_GNUC_UNUSED)
+ * {
+ *   gtk_gadget_class_finalize ((GtkGadgetClass*) klass);
+ * }
+ *
+ * static void gtk_gadget_instance_intern_init (GTypeInstance *instance, gpointer klass G_GNUC_UNUSED)
+ * {
+ *   gtk_gadget_init ((GtkGadget*) instance);
+ * }
  * 
  * GType
  * gtk_gadget_get_type (void)
@@ -149,11 +159,11 @@
  *     (GBaseInitFunc) NULL,
  *     (GBaseFinalizeFunc) NULL,
  *     gtk_gadget_class_intern_init,
- *     (GClassFinalizeFunc) gtk_gadget_class_finalize,
+ *     gtk_gadget_class_finalize_intern,
  *     NULL,   // class_data
  *     sizeof (GtkGadget),
  *     0,      // n_preallocs
- *     (GInstanceInitFunc) gtk_gadget_init, 
+ *     gtk_gadget_instance_intern_init,
  *     NULL    // value_table
  *   };
  *   gtk_gadget_type_id = g_type_module_register_type (type_module,
@@ -182,6 +192,20 @@
 \
 _G_DEFINE_TYPE_EXTENDED_CLASS_INIT(TypeName, type_name) \
 \
+static void \
+type_name##_class_finalize_intern (gpointer klass, \
+                                  gpointer class_data G_GNUC_UNUSED) \
+{ \
+  type_name##_class_finalize ((TypeName##Class*) klass); \
+} \
+\
+static void \
+type_name##_instance_intern_init (GTypeInstance *instance, \
+                                 gpointer klass G_GNUC_UNUSED) \
+{ \
+  type_name##_init ((TypeName*) instance); \
+} \
+\
 G_GNUC_UNUSED \
 static inline gpointer \
 type_name##_get_instance_private (TypeName *self) \
@@ -203,11 +227,11 @@
     (GBaseInitFunc) NULL, \
     (GBaseFinalizeFunc) NULL, \
     type_name##_class_intern_init, \
-    (GClassFinalizeFunc)(void (*)(void)) type_name##_class_finalize, \
+    type_name##_class_finalize_intern, \
     NULL,   /* class_data */ \
     sizeof (TypeName), \
     0,      /* n_preallocs */ \
-    (GInstanceInitFunc)(void (*)(void)) type_name##_init, \
+    type_name##_instance_intern_init, \
     NULL    /* value_table */ \
   }; \
   type_name##_type_id = g_type_module_register_type (type_module, \
diff --git a/gobject/tests/cxx.cpp b/gobject/tests/cxx.cpp
--- a/gobject/tests/cxx.cpp
+++ b/gobject/tests/cxx.cpp
@@ -56,23 +56,89 @@
   instance_init_count++;
 }
 
+typedef CxxTestObject CxxDynamicObject;
+typedef CxxTestObjectClass CxxDynamicObjectClass;
+
+GType cxx_dynamic_object_get_type (void);
+
+G_DEFINE_DYNAMIC_TYPE (CxxDynamicObject, cxx_dynamic_object, G_TYPE_OBJECT)
+
+static void
+cxx_dynamic_object_class_init (CxxDynamicObjectClass *klass)
+{
+  cxx_test_object_class_init (klass);
+}
+
+static void
+cxx_dynamic_object_class_finalize (CxxDynamicObjectClass *klass)
+{
+}
+
+static void
+cxx_dynamic_object_init (CxxDynamicObject *self)
+{
+  cxx_test_object_init (self);
+}
+
+typedef GTypeModule CxxTestModule;
+typedef GTypeModuleClass CxxTestModuleClass;
+
+GType cxx_test_module_get_type (void);
+
+G_DEFINE_TYPE (CxxTestModule, cxx_test_module, G_TYPE_TYPE_MODULE)
+
+static gboolean
+cxx_test_module_load (GTypeModule *module)
+{
+  cxx_dynamic_object_register_type (module);
+  return TRUE;
+}
+
+static void
+cxx_test_module_unload (GTypeModule *module)
+{
+}
+
+static void
+cxx_test_module_class_init (CxxTestModuleClass *klass)
+{
+  klass->load = cxx_test_module_load;
+  klass->unload = cxx_test_module_unload;
+}
+
+static void
+cxx_test_module_init (CxxTestModule *self)
+{
+}
+
 int
 main (void)
 {
-  guint i;
-  GType type = cxx_test_object_get_type ();
+  guint i, j;
+  GType types[2];
+  /* Registered dynamic types require the module to remain alive. */
+  GTypeModule *module = (GTypeModule *) g_object_new (cxx_test_module_get_type (), NULL);
 
-  for (i = 0; i < 2; i++)
-    {
-      CxxTestObject *object = (CxxTestObject *) g_object_new (type, NULL);
+  g_assert_true (g_type_module_use (module));
+  types[0] = cxx_test_object_get_type ();
+  types[1] = cxx_dynamic_object_get_type ();
+  g_assert_cmpuint (types[1], !=, 0);
+  g_type_module_unuse (module);
 
-      g_assert_cmpuint (object->initialized, ==, 23);
-      g_assert_cmpuint (object->parent.ref_count, ==, 1);
-      g_assert_cmpuint (cxx_test_object_get_type (), ==, type);
-      g_object_unref (object);
-    }
-  g_assert_cmpuint (class_init_count, ==, 1);
-  g_assert_cmpuint (instance_init_count, ==, 2);
+  for (i = 0; i < G_N_ELEMENTS (types); i++)
+    for (j = 0; j < 2; j++)
+      {
+        CxxTestObject *object = (CxxTestObject *) g_object_new (types[i], NULL);
+
+        g_assert_cmpuint (object->initialized, ==, 23);
+        g_assert_cmpuint (object->parent.ref_count, ==, 1);
+        g_assert_cmpuint (G_OBJECT_TYPE (object), ==, types[i]);
+        g_object_unref (object);
+      }
+  g_assert_cmpuint (class_init_count, ==, 2);
+  g_assert_cmpuint (instance_init_count, ==, 4);
+  g_assert_cmpuint (cxx_test_object_get_type (), ==, types[0]);
+  g_assert_cmpuint (cxx_dynamic_object_get_type (), ==, types[1]);
 
   return 0;
 }
