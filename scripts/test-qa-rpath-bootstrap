#!/bin/bash
set -eu

repo=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
inherit() {
	local name
	for name; do
		case ${name} in
			qa-rpath|rpath-sanitizer) source "${repo}/eclass/${name}.eclass" ;;
		esac
	done
}

(
	BDEPEND=
	source "${repo}/eclass/qa-policy.eclass"
	[[ ${BDEPEND} == *app-dev/patchelf* ]]
)
(
	BDEPEND=
	QA_POLICY_RPATH_CLEAN=0
	source "${repo}/eclass/qa-policy.eclass"
	[[ ${BDEPEND} != *app-dev/patchelf* ]]
	_qa-policy-apply-defaults
	[[ ${QA_POLICY_RPATH_MODE} == fail ]]

	QA_DISCOVER_ELF_FILES=( /image/usr/bin/probe )
	_rpath-get() { echo /build/lib; }
	_rpath-has-build-leak() { return 0; }
	_qa-policy-relpath() { echo /usr/bin/probe; }
	qa-report-domain-begin() { :; }
	qa-report-domain-stat() { :; }
	qa-rpath-clean-one() { echo 'unexpected RPATH rewrite' >&2; exit 1; }
	_qa-report-record-mode() { reports+=("$2:$3"); }
	reports=()

	qa-rpath-sanitize
	qa-rpath-assert
	[[ ${reports[*]} == fail:build-path ]]
)

echo 'PASS: bootstrap RPATH checks retain failure policy without patchelf'
