+                    gpointer user_data)
 {
   GSList list, *l;
   gint cmp;
@@ -961,7 +972,7 @@ g_slist_sort_merge (GSList   *l1,
 
   while (l1 && l2)
     {
-      cmp = ((GCompareDataFunc) compare_func) (l1->data, l2->data, user_data);
+      cmp = compare_func (l1->data, l2->data, user_data);
 
       if (cmp <= 0)
         {
@@ -980,9 +991,9 @@ g_slist_sort_merge (GSList   *l1,
 }
 
 static GSList *
-g_slist_sort_real (GSList   *list,
-                   GFunc     compare_func,
-                   gpointer  user_data)
+g_slist_sort_real (GSList *list,
+                   GCompareDataFunc compare_func,
+                   gpointer user_data)
 {
   GSList *l1, *l2;
 
@@ -1027,7 +1038,7 @@ GSList *
 g_slist_sort (GSList       *list,
               GCompareFunc  compare_func)
 {
-  return g_slist_sort_real (list, (GFunc) compare_func, NULL);
+  return g_slist_sort_real (list, compare_without_data, &compare_func);
 }
 
 /**
@@ -1045,7 +1056,7 @@ g_slist_sort_with_data (GSList           *list,
                         GCompareDataFunc  compare_func,
                         gpointer          user_data)
 {
-  return g_slist_sort_real (list, (GFunc) compare_func, user_data);
+  return g_slist_sort_real (list, compare_func, user_data);
 }
 
