From 8a660d1a698e01d2c30e85551d9ea150355a9e7b Mon Sep 17 00:00:00 2001
From: Paul Moses <p@1g4.org>
Date: Sun, 27 Sep 2026 12:53:41 -0500
Subject: [PATCH] libcrypt: build and expose the legacy DES API on musl

The strong-only hash profile compiled the DES primitive and tables out, including their internal namespacing. Adapt those guards in generated copies to include legacy API users without selecting DES password hashing or modifying the pinned import.

Make compatibility-only exports default versions on musl so its loader can resolve them. Keep glibc exports and native libcrypt.so.2 unchanged. Validated with a real musl 1.2.5 toolchain (37 tests, differential skipped) and glibc (41 tests including differential checks).
---
 compat/libcrypt/legacy/adapt-des.pl    | 19 +++++++++++++++
 compat/libcrypt/legacy/meson.build     | 33 +++++++++++++++++++++-----
 compat/libcrypt/legacy/musl-symbols.pl | 11 +++++++++
 3 files changed, 57 insertions(+), 6 deletions(-)
 create mode 100644 compat/libcrypt/legacy/adapt-des.pl
 create mode 100644 compat/libcrypt/legacy/musl-symbols.pl

diff --git a/compat/libcrypt/legacy/adapt-des.pl b/compat/libcrypt/legacy/adapt-des.pl
new file mode 100644
index 0000000..1fae865
--- /dev/null
+++ b/compat/libcrypt/legacy/adapt-des.pl
@@ -0,0 +1,19 @@
+use strict;
+use warnings;
+
+# Keep the pinned import intact. Its DES guards account for password hashes,
+# but not for the independently selected encrypt/setkey compatibility API.
+@ARGV == 1 or die "usage: adapt-des.pl SOURCE\n";
+open my $input, '<', $ARGV[0] or die "$ARGV[0]: $!\n";
+local $/;
+my $source = <$input>;
+my $count = $source =~ s{
+    ^(\#if\ INCLUDE_descrypt\ \|\|\ INCLUDE_
+      (?:bigcrypt\ \|\|\ INCLUDE_bsdicrypt|bsdicrypt\ \|\|\ INCLUDE_bigcrypt))$
+}{
+    "$1 || \\\n" .
+    "    ((INCLUDE_encrypt || INCLUDE_encrypt_r || INCLUDE_setkey || INCLUDE_setkey_r) && \\\n" .
+    "     !ENABLE_OBSOLETE_API_ENOSYS)"
+}mex;
+$count == 1 or die "$ARGV[0]: expected exactly one DES implementation guard\n";
+print $source;
diff --git a/compat/libcrypt/legacy/meson.build b/compat/libcrypt/legacy/meson.build
index e099489..49d5d0f 100644
--- a/compat/libcrypt/legacy/meson.build
+++ b/compat/libcrypt/legacy/meson.build
@@ -32,22 +32,43 @@ libcrypt_compat_map = configure_file(
             libcrypt_compat_policy, '@INPUT@'],
   capture: true,
 )
+libcrypt_compat_symver_command = [libcrypt_perl]
+if not libcrypt_glibc
+  libcrypt_compat_symver_command += files('musl-symbols.pl')
+endif
 configure_file(
   input: '../../../vendor/libxcrypt/lib/libcrypt.map.in',
   output: 'crypt-symbol-vers.h',
-  command: [libcrypt_perl, files('../../../vendor/libxcrypt/scripts/gen-crypt-symbol-vers-h'),
+  command: libcrypt_compat_symver_command + [files('../../../vendor/libxcrypt/scripts/gen-crypt-symbol-vers-h'),
             'yes', libcrypt_compat_policy, '@INPUT@'],
   capture: true,
 )
 if build_shared_libs
-  libcrypt_compat_sources = libcrypt_sources + files('../../../vendor/libxcrypt/lib/crypt-des-obsolete.c')
+  # Copied sources find the adapted crypt-port.h beside them. This keeps the
+  # primitive, tables and internal names under the same API-aware guard,
+  # without changing the generated hash table or the pinned vendor import.
+  configure_file(
+    input: '../../../vendor/libxcrypt/lib/crypt-port.h',
+    output: 'crypt-port.h',
+    command: [libcrypt_perl, files('adapt-des.pl'), '@INPUT@'],
+    capture: true,
+  )
+  libcrypt_compat_sources = libcrypt_sources + [configure_file(
+    input: '../../../vendor/libxcrypt/lib/crypt-des-obsolete.c',
+    output: 'crypt-des-obsolete.c',
+    copy: true,
+  )]
   # The musl hash profile omits DES hashing, but the old encrypt/setkey ABI
   # still needs the DES primitive. Do not enable additional password hashes.
   if not libcrypt_glibc
-    libcrypt_compat_sources += files(
-      '../../../vendor/libxcrypt/lib/alg-des.c',
-      '../../../vendor/libxcrypt/lib/alg-des-tables.c',
-    )
+    foreach source : ['alg-des.c', 'alg-des-tables.c']
+      libcrypt_compat_sources += [configure_file(
+        input: '../../../vendor/libxcrypt/lib/' + source,
+        output: source,
+        command: [libcrypt_perl, files('adapt-des.pl'), '@INPUT@'],
+        capture: true,
+      )]
+    endforeach
   endif
   # A suffix, rather than soversion, avoids installing a competing libcrypt.so
   # development symlink. New links must continue to select the native .so.2.
diff --git a/compat/libcrypt/legacy/musl-symbols.pl b/compat/libcrypt/legacy/musl-symbols.pl
new file mode 100644
index 0000000..d572734
--- /dev/null
+++ b/compat/libcrypt/legacy/musl-symbols.pl
@@ -0,0 +1,11 @@
+use strict;
+use warnings;
+
+# musl ignores symbol versions and rejects non-default versions. Make the
+# compatibility-only exports default in .so.1; new links still use .so.2.
+open my $generator, '-|', $^X, @ARGV or die "symbol generator: $!\n";
+while (<$generator>) {
+    s/\bsymver_compat0\b/symver_default/g;
+    print;
+}
+close $generator or die "symbol generator failed: $?\n";
