+
+#include "config.h"
+
+#include "vte/vte.h"
+
+static void
+pty_changed(GObject*,
+            GParamSpec*,
+            unsigned* notifications)
+{
+        ++*notifications;
+}
+
+static void
+test_widget_pty(void)
+{
+        auto terminal = VTE_TERMINAL(g_object_ref_sink(vte_terminal_new()));
+        unsigned notifications = 0;
+        g_signal_connect(terminal, "notify::pty", G_CALLBACK(pty_changed), &notifications);
+
+        g_assert_null(vte_terminal_get_pty(terminal));
+        vte_terminal_set_pty(terminal, nullptr);
+        g_assert_cmpuint(notifications, ==, 0);
+
+        GError* error = nullptr;
+        auto pty = vte_pty_new_sync(VTE_PTY_DEFAULT, nullptr, &error);
+        g_assert_no_error(error);
+        g_assert_nonnull(pty);
+        void* weak_pty = pty;
+        g_object_add_weak_pointer(G_OBJECT(pty), &weak_pty);
+
+        vte_terminal_set_pty(terminal, pty);
+        g_assert_true(vte_terminal_get_pty(terminal) == pty);
+        g_assert_cmpuint(notifications, ==, 1);
+        vte_terminal_set_pty(terminal, pty);
+        g_assert_cmpuint(notifications, ==, 1);
+        g_object_unref(pty);
+
+        vte_terminal_set_pty(terminal, nullptr);
+        g_assert_null(vte_terminal_get_pty(terminal));
+        g_assert_null(weak_pty);
+        g_assert_cmpuint(notifications, ==, 2);
+        vte_terminal_set_pty(terminal, nullptr);
+        g_assert_cmpuint(notifications, ==, 2);
+
+        pty = vte_pty_new_sync(VTE_PTY_DEFAULT, nullptr, &error);
+        g_assert_no_error(error);
+        g_assert_nonnull(pty);
+        vte_terminal_set_pty(terminal, pty);
+        g_assert_true(vte_terminal_get_pty(terminal) == pty);
+        g_assert_cmpuint(notifications, ==, 3);
+        g_object_unref(pty);
+
+        g_object_set(terminal, "pty", nullptr, nullptr);
+        g_assert_null(vte_terminal_get_pty(terminal));
+        g_assert_cmpuint(notifications, ==, 4);
+        g_object_unref(terminal);
+}
+
+int
+main(int argc,
+     char* argv[])
+{
+        g_test_init(&argc, &argv, nullptr);
+#if VTE_GTK == 3
+        if (!gtk_init_check(&argc, &argv))
+#else
+        if (!gtk_init_check())
+#endif
+                return 77;
+
+        g_test_add_func("/vte/widget/pty", test_widget_pty);
+        return g_test_run();
+}
diff --git a/src/widget.cc b/src/widget.cc
index 4489a3a..e171f6c 100644
--- a/src/widget.cc
+++ b/src/widget.cc
@@ -2229,7 +2229,7 @@ Widget::set_pty(VtePty* pty_obj) noexcept
                 return false;
 
         m_pty = vte::glib::make_ref(pty_obj);
-        terminal()->set_pty(_vte_pty_get_impl(pty()));
+        terminal()->set_pty(pty() ? _vte_pty_get_impl(pty()) : nullptr);
 
         return true;
 }

