Subject: notebook: Balance page-owned tab-label references

Base: 34dc3af563f767348ca575827f414a50c0458b0e

GtkNotebookPage owns the tab-label reference established by its construct
property. Removal unparents the label and clears that pointer without
unreffing it. Replacement and hiding default tabs have the same release
problem; replacement also omits the page-owned reference for new labels.

Release the page reference when removing a label. Keep a separate page
reference when setting custom and default replacements, and reuse removal
when hiding default tabs so mnemonic handlers are disconnected too.

Add notebook tests for removal, replacement, hide/show, destruction, a
retained page object, and caller-owned labels.

--- a/gtk/gtknotebook.c
+++ b/gtk/gtknotebook.c
@@ -4310,7 +4310,7 @@
           gtk_widget_unparent (page->tab_label);
         }
 
-      page->tab_label = NULL;
+      g_clear_object (&page->tab_label);
     }
 }
 
@@ -6255,8 +6255,7 @@
           children = children->next;
           if (page->default_tab)
             {
-              gtk_widget_unparent (page->tab_label);
-              page->tab_label = NULL;
+              gtk_notebook_remove_tab_label (notebook, page);
             }
           else
             gtk_widget_set_visible (page->tab_label, FALSE);
@@ -6620,7 +6619,7 @@
   if (tab_label)
     {
       page->default_tab = FALSE;
-      page->tab_label = tab_label;
+      g_set_object (&page->tab_label, tab_label);
       g_object_set_data (G_OBJECT (page->tab_label), "notebook", notebook);
       gtk_widget_set_parent (page->tab_label, page->tab_widget);
     }
@@ -6636,6 +6635,7 @@
           g_snprintf (string, sizeof(string), _("Page %u"),
                       g_list_position (notebook->children, list));
           page->tab_label = gtk_label_new (string);
+          g_object_ref_sink (page->tab_label);
           gtk_widget_set_parent (page->tab_label, page->tab_widget);
           g_object_set_data (G_OBJECT (page->tab_label), "notebook", notebook);
         }
