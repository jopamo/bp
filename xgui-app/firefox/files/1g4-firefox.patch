+add_task(async function test_observer_drops_reads_from_before_close() {
+  const query = new PlacesQuery();
+  const url = "https://observer-close.example.com/";
+  const started = Promise.withResolvers();
+  const pending = Promise.withResolvers();
+  const oldCallback = sinon.spy();
+  const newCallback = sinon.spy();
+  await PlacesUtils.history.insert({ url, visits: [{ date: new Date() }] });
+  const history = await query.getHistory();
+  query.observeHistory(oldCallback);
+  const getHistory = sinon.stub(query, "getHistory").callsFake(() => {
+    started.resolve();
+    return pending.promise;
+  });
+
+  try {
+    await PlacesUtils.history.remove(url);
+    await started.promise;
+    query.close();
+    getHistory.restore();
+    await query.getHistory();
+    query.observeHistory(newCallback);
+    pending.resolve(history);
+    await TestUtils.waitForTick();
+    Assert.ok(!oldCallback.called, "Do not call the old observer");
+    Assert.ok(!newCallback.called, "Do not send old data to the new observer");
+  } finally {
+    pending.resolve(history);
+    query.close();
+  }
+});
