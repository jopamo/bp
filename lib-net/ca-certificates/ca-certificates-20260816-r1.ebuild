inherit python-any-r1

DESCRIPTION="Common CA Certificates PEM files"
HOMEPAGE="https://packages.debian.org/sid/ca-certificates"
SNAPSHOT=36f904035c8390db4f0834c644c3e6ceceec01f5
SRC_URI="https://salsa.debian.org/debian/ca-certificates/-/archive/${SNAPSHOT}/ca-certificates-${SNAPSHOT}.tar.bz2"
S="${WORKDIR}/ca-certificates-${SNAPSHOT}"

LICENSE="MPL-1.1"

SLOT="0"
KEYWORDS="amd64 arm64"

IUSE="test"
RESTRICT="!test? ( test )"

BDEPEND="
	${PYTHON_DEPS}
	virtual/ssl
"
RDEPEND="
	app-core/debianutils
	virtual/ssl
"

PATCHES=( "${FILESDIR}/update-ca-certificates-relative-links.patch" )

pkg_setup() {
	# For the conversion to having it in CONFIG_PROTECT_MASK,
	# we need to tell users about it once manually first.
	[[ -f "${EPREFIX}"/etc/env.d/98ca-certificates ]] \
		|| ewarn "You should run update-ca-certificates manually after etc-update"

	python-any-r1_pkg_setup
}

src_prepare() {
	default
	cp "${FILESDIR}"/{certdata.txt,nssckbi.h,certdata2pem.py} "${S}/mozilla/" || die
}

src_compile() {
	emake -C mozilla clean
	(cd mozilla && "${EPYTHON}" certdata2pem.py) || die
}

src_test() {
	"${EPYTHON}" "${FILESDIR}/test_certificates.py" "${S}" || die "certificate tests failed"
}

src_install() {
	keepdir /etc/ssl/certs
	dobin sbin/update-ca-certificates
	doman sbin/update-ca-certificates.8
	dosym certs/ca-certificates.crt /etc/ssl/cert.pem

	local f enddate expiry now
	now=$(date -u +%s) || die
	insinto /usr/share/ca-certificates/mozilla
	for f in "${S}"/mozilla/*.crt; do
		enddate=$(openssl x509 -in "${f}" -noout -enddate) || die "invalid certificate: ${f}"
		expiry=$(LC_ALL=C "${EPYTHON}" - "${enddate}" <<-'PY'
			from datetime import datetime, timezone
			import sys
			expiry = datetime.strptime(sys.argv[1], "notAfter=%b %d %H:%M:%S %Y GMT")
			print(int(expiry.replace(tzinfo=timezone.utc).timestamp()))
		PY
		) || die "invalid expiry date: ${f}"
		if (( expiry > now )); then
			doins "${f}"
		else
			einfo "Skipping expired certificate: ${f##*/}"
		fi
	done

	dodir /etc
	{
		echo "# Automatically generated by ${CATEGORY}/${PF}"
		echo "# Do not edit."

		find "${ED}/usr/share/ca-certificates" -type f -name '*.crt' \
			| sed "s|^${ED}/usr/share/ca-certificates/||" \
			| LC_ALL=C sort
	} > "${ED}/etc/ca-certificates.conf" || die "Failed to generate ca-certificates.conf"
}

pkg_postinst() {
	"${EROOT}/usr/bin/update-ca-certificates" --fresh --sysroot "${EROOT%/}" \
		|| die "failed to update CA certificates in ${EROOT}"
}
