+
+void TestSharing::testContainer()
+{
+    QFETCH(QString, suffix);
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    Config::createConfigFromFile(dir.filePath("config.ini"), dir.filePath("local.ini"));
+    KeeShareSettings::Own own;
+    own.key.key = stubkey();
+    own.certificate.key = own.key.key;
+    KeeShare::setOwn(own);
+
+    Database source;
+    source.rootGroup()->setName("Shared");
+    auto entry = new Entry();
+    entry->setUuid(QUuid::createUuid());
+    entry->setTitle("Shared entry");
+    entry->setPassword("secret");
+    entry->setGroup(source.rootGroup());
+    KeeShareSettings::Reference reference;
+    reference.password = "share password";
+    reference.path = dir.filePath(QString::fromUtf8("share-é") + suffix);
+
+    auto result = ShareExport::intoContainer(reference.path, reference, source.rootGroup());
+    QVERIFY2(!result.isError(), qPrintable(result.message));
+    entry->setPassword("updated secret");
+    result = ShareExport::intoContainer(reference.path, reference, source.rootGroup());
+    QVERIFY2(!result.isError(), qPrintable(result.message));
+
+    Database target;
+    result = ShareImport::containerInto(reference.path, reference, target.rootGroup());
+    QVERIFY2(!result.isError(), qPrintable(result.message));
+    auto imported = target.rootGroup()->findEntryByUuid(entry->uuid());
+    QVERIFY(imported);
+    QCOMPARE(imported->password(), QString("updated secret"));
+
+    if (suffix == ".kdbx.share") {
+        auto archive = zip_open(QFile::encodeName(reference.path).constData(), ZIP_RDONLY, nullptr);
+        QVERIFY(archive);
+        QCOMPARE(zip_get_num_entries(archive, 0), 2);
+        QVERIFY(zip_name_locate(archive, KeeShare::containerFileName().toUtf8().constData(), 0) >= 0);
+        QVERIFY(zip_name_locate(archive, KeeShare::signatureFileName().toUtf8().constData(), 0) >= 0);
+        zip_discard(archive);
+
+        QFile file(reference.path);
+        QVERIFY(file.open(QIODevice::WriteOnly | QIODevice::Truncate));
+        QCOMPARE(file.write("broken archive"), 14);
+        file.close();
+        result = ShareImport::containerInto(reference.path, reference, target.rootGroup());
+        QVERIFY(result.isError());
+
+        result = ShareExport::intoContainer(dir.filePath("missing/share.kdbx.share"), reference, source.rootGroup());
+        QVERIFY(result.isError());
+    }
+    config()->sync();
+}
