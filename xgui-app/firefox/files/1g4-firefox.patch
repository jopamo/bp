diff --git a/browser/components/newtab/LocalTopSites.sys.mjs b/browser/components/newtab/LocalTopSites.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d756f9376614517764f26b3cddb47dc770ba661c
--- /dev/null
+++ b/browser/components/newtab/LocalTopSites.sys.mjs
@@ -0,0 +1,408 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { AppConstants } from "resource://gre/modules/AppConstants.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  NewTabUtils: "resource://gre/modules/NewTabUtils.sys.mjs",
+  PlacesUtils: "resource://gre/modules/PlacesUtils.sys.mjs",
+});
+
+const HISTORY_PREF = "places.history.enabled";
+const NEWTAB_PREF = "browser.newtabpage.enabled";
+const REMOVAL_EVENTS = ["history-cleared", "page-removed"];
+const VISIT_EVENTS = ["page-visited", "pages-rank-changed"];
+const ICON_EVENTS = ["favicon-changed"];
+const TILE_LIMIT = 8;
+const ICON_TYPES = new Set(["image/png", "image/svg+xml"]);
+
+function displayHost(page) {
+  return page.hostname.replace(/^www\./, "");
+}
+
+export function canShowLocalTopSites(spec, privateBrowsingId) {
+  return (
+    AppConstants.MOZ_1G4_PRIVACY &&
+    privateBrowsingId === 0 &&
+    Services.prefs.getBoolPref(HISTORY_PREF, true) &&
+    (spec === "about:home" ||
+      (spec === "about:newtab" && Services.prefs.getBoolPref(NEWTAB_PREF, true)))
+  );
+}
+
+async function readIcon(page) {
+  try {
+    // Read bytes from Places. Never use the icon's original (possibly remote)
+    // URI. A lookup for the origin can also find icons saved on sibling pages.
+    const find = url =>
+      lazy.PlacesUtils.favicons.getFaviconForPage(Services.io.newURI(url), 64);
+    let icon = await find(page.href);
+    if (!icon && page.href !== page.origin + "/") {
+      icon = await find(page.origin);
+    }
+    if (icon && ICON_TYPES.has(icon.mimeType) && icon.dataURI.schemeIs("data")) {
+      return icon.dataURI.spec;
+    }
+  } catch {
+    // A missing or unreadable icon is just a monogram.
+  }
+  return null;
+}
+
+async function readPages() {
+  const links = await lazy.NewTabUtils.activityStreamLinks.getTopSites({
+    numItems: 96,
+    onePerDomain: false,
+    includeFavicon: false,
+    topsiteFrecency: 1,
+  });
+  const hosts = new Set();
+  const pages = [];
+  const { blockedLinks } = lazy.NewTabUtils;
+  for (const link of links) {
+    const page = URL.parse(link.original_url ?? link.url);
+    if (
+      !page ||
+      !["https:", "http:"].includes(page.protocol) ||
+      page.username ||
+      page.password ||
+      blockedLinks.isBlocked({ url: page.href }) ||
+      blockedLinks.isBlocked({ url: page.origin + "/" })
+    ) {
+      continue;
+    }
+    const host = displayHost(page);
+    if (hosts.has(host)) {
+      continue;
+    }
+    hosts.add(host);
+    pages.push({ host, page });
+    if (pages.length === TILE_LIMIT) {
+      break;
+    }
+  }
+  return pages;
+}
+
+function readTiles(pages) {
+  // Keep paths, titles, queries, and fragments out of the page.
+  return Promise.all(
+    pages.map(async ({ host, page }) => ({
+      host,
+      url: page.origin,
+      icon: await readIcon(page),
+    }))
+  );
+}
+
+export async function readLocalTopSites() {
+  return readTiles(await readPages());
+}
+
+export class LocalTopSitesParent extends JSWindowActorParent {
+  #observing = false;
+  #generation = 0;
+  #pages = null;
+  #retryEmptyRead = false;
+
+  #canRead() {
+    const { browsingContext, manager } = this;
+    return (
+      !browsingContext.parent &&
+      !browsingContext.usePrivateBrowsing &&
+      manager.isCurrentGlobal &&
+      canShowLocalTopSites(
+        manager.documentURI?.spec,
+        browsingContext.originAttributes.privateBrowsingId
+      )
+    );
+  }
+
+  async receiveMessage({ name }) {
+    if ((name !== "GetSites" && name !== "GetIcons") || !this.#canRead()) {
+      return [];
+    }
+    if (name === "GetIcons" && !this.#pages) {
+      return [];
+    }
+    if (!this.#observing) {
+      Services.prefs.addObserver(HISTORY_PREF, this.#invalidate);
+      Services.prefs.addObserver(NEWTAB_PREF, this.#invalidate);
+      Services.prefs.addObserver(
+        lazy.NewTabUtils.blockedLinks.prefName,
+        this.#invalidate
+      );
+      PlacesObservers.addListener(REMOVAL_EVENTS, this.#invalidate);
+      PlacesObservers.addListener(VISIT_EVENTS, this.#refreshEmpty);
+      PlacesObservers.addListener(ICON_EVENTS, this.#faviconsChanged);
+      Services.obs.addObserver(
+        this.#faviconsExpired,
+        lazy.PlacesUtils.TOPIC_FAVICONS_EXPIRED
+      );
+      this.#observing = true;
+    }
+
+    const generation =
+      name === "GetSites" ? ++this.#generation : this.#generation;
+    let pages = this.#pages;
+    if (name === "GetSites") {
+      this.#pages = null;
+      do {
+        this.#retryEmptyRead = false;
+        pages = await readPages();
+        if (generation !== this.#generation || !this.#canRead()) {
+          return [];
+        }
+      } while (!pages.length && this.#retryEmptyRead);
+      this.#pages = pages;
+    }
+    // Icon refreshes can only read the candidates selected by the parent.
+    const tiles = await readTiles(pages);
+    return generation === this.#generation &&
+      pages === this.#pages &&
+      this.#canRead()
+      ? tiles
+      : [];
+  }
+
+  #refreshEmpty = () => {
+    if (this.#pages?.length || !this.#canRead()) {
+      return;
+    }
+    if (this.#pages === null) {
+      this.#retryEmptyRead = true;
+    } else {
+      this.#invalidate();
+    }
+  };
+
+  #faviconsChanged = events => {
+    if (
+      !this.#pages ||
+      events.some(event => {
+        const changed = URL.parse(event.url);
+        // Places can share root icons across HTTP/HTTPS and www variants.
+        return (
+          changed &&
+          this.#pages.some(({ host }) => host === displayHost(changed))
+        );
+      })
+    ) {
+      this.#faviconsExpired();
+    }
+  };
+
+  #faviconsExpired = () => {
+    if (this.#canRead()) {
+      this.#notify("IconsChanged");
+    }
+  };
+
+  #invalidate = () => {
+    this.#generation++;
+    this.#pages = null;
+    this.#notify("Refresh");
+  };
+
+  #notify(name) {
+    if (!this.manager.isClosed && this.manager.isCurrentGlobal) {
+      try {
+        this.sendAsyncMessage(name);
+      } catch (error) {
+        if (error.name !== "InvalidStateError") {
+          throw error;
+        }
+      }
+    }
+  }
+
+  didDestroy() {
+    this.#generation++;
+    this.#pages = null;
+    if (this.#observing) {
+      PlacesObservers.removeListener(REMOVAL_EVENTS, this.#invalidate);
+      PlacesObservers.removeListener(VISIT_EVENTS, this.#refreshEmpty);
+      PlacesObservers.removeListener(ICON_EVENTS, this.#faviconsChanged);
+      Services.obs.removeObserver(
+        this.#faviconsExpired,
+        lazy.PlacesUtils.TOPIC_FAVICONS_EXPIRED
+      );
+      Services.prefs.removeObserver(HISTORY_PREF, this.#invalidate);
+      Services.prefs.removeObserver(NEWTAB_PREF, this.#invalidate);
+      Services.prefs.removeObserver(
+        lazy.NewTabUtils.blockedLinks.prefName,
+        this.#invalidate
+      );
+    }
+  }
+}
+
+export class LocalTopSitesChild extends JSWindowActorChild {
+  #view = null;
+  #shown = false;
+
+  handleEvent({ type }) {
+    this.#shown = type === "pageshow";
+    return this.#refresh();
+  }
+
+  receiveMessage({ name }) {
+    if (name === "Refresh") {
+      return this.#refresh();
+    }
+    if (name === "IconsChanged" && this.#view) {
+      this.#view.iconsChanged = true;
+      return this.#refreshIcons(this.#view);
+    }
+    return undefined;
+  }
+
+  didDestroy() {
+    this.#view = null;
+  }
+
+  #canShow(doc) {
+    return (
+      this.#shown &&
+      canShowLocalTopSites(
+        doc.documentURI,
+        this.browsingContext.originAttributes.privateBrowsingId
+      )
+    );
+  }
+
+  #isCurrent(view) {
+    return (
+      this.#view === view &&
+      this.document === view.doc &&
+      this.#canShow(view.doc)
+    );
+  }
+
+  async #query(name) {
+    try {
+      return await this.sendQuery(name);
+    } catch (error) {
+      if (error.name !== "InvalidStateError" && error.name !== "AbortError") {
+        console.error(error);
+      }
+      return [];
+    }
+  }
+
+  async #refresh() {
+    this.#view = null;
+    const doc = this.document;
+    const main = doc?.getElementById("local-top-sites");
+    if (!main) {
+      return;
+    }
+    const list = main.querySelector("ul");
+    main.hidden = true;
+    list.replaceChildren();
+    if (!this.#canShow(doc)) {
+      return;
+    }
+
+    const view = {
+      doc,
+      tiles: new Map(),
+      loading: true,
+      refreshingIcons: false,
+      iconsChanged: false,
+    };
+    this.#view = view;
+    const sites = await this.#query("GetSites");
+    if (!this.#isCurrent(view)) {
+      return;
+    }
+
+    for (const { host, url, icon } of sites) {
+      const item = doc.createElement("li");
+      const link = doc.createElement("a");
+      link.href = url;
+      link.rel = "noreferrer";
+      const tile = doc.createElement("span");
+      tile.className = "site-icon";
+      tile.setAttribute("aria-hidden", "true");
+      let color = 0;
+      for (let i = 0; i < host.length; ++i) {
+        color = (Math.imul(color, 31) + host.charCodeAt(i)) >>> 0;
+      }
+      tile.dataset.tint = color % 4;
+      const monogram = doc.createElement("span");
+      monogram.textContent = host[0].toUpperCase();
+      tile.append(monogram);
+      if (!view.iconsChanged) {
+        this.#setIcon(tile, icon);
+      }
+      view.tiles.set(url, tile);
+      const label = doc.createElement("span");
+      label.className = "site-host";
+      label.dir = "ltr";
+      label.title = host;
+      label.textContent = host;
+      link.append(tile, label);
+      item.append(link);
+      list.append(item);
+    }
+    main.hidden = !sites.length;
+    view.loading = false;
+    return this.#refreshIcons(view);
+  }
+
+  async #refreshIcons(view) {
+    if (view.loading || view.refreshingIcons) {
+      return;
+    }
+    view.refreshingIcons = true;
+    while (view.iconsChanged && this.#isCurrent(view)) {
+      view.iconsChanged = false;
+      const sites = await this.#query("GetIcons");
+      if (!this.#isCurrent(view) || view.iconsChanged) {
+        continue;
+      }
+      for (const { url, icon } of sites) {
+        const tile = view.tiles.get(url);
+        if (tile) {
+          this.#setIcon(tile, icon);
+        }
+      }
+    }
+    view.refreshingIcons = false;
+  }
+
+  #setIcon(tile, icon) {
+    const old = tile.querySelector("img");
+    if ((old?.getAttribute("src") ?? null) === icon) {
+      return;
+    }
+    old?.remove();
+    tile.classList.remove("has-icon");
+    const monogram = tile.firstElementChild;
+    monogram.hidden = false;
+    if (!icon) {
+      return;
+    }
+
+    const img = tile.ownerDocument.createElement("img");
+    img.alt = "";
+    img.hidden = true;
+    img.addEventListener(
+      "load",
+      () => {
+        if (img.parentNode === tile) {
+          tile.classList.add("has-icon");
+          monogram.hidden = true;
+          img.hidden = false;
+        }
+      },
+      { once: true }
+    );
+    img.addEventListener("error", () => img.remove(), { once: true });
+    img.src = icon;
+    tile.append(img);
+  }
+}
diff --git a/browser/components/newtab/local-top-sites.css b/browser/components/newtab/local-top-sites.css
