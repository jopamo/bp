diff --git a/clang/lib/Driver/ToolChains/Linux.cpp b/clang/lib/Driver/ToolChains/Linux.cpp
index d525b417b4eae4d11ba6cb99fe29ecf1cc434d22..c20e08830baba363acc679af745e39ef7b4add82 100644
--- a/clang/lib/Driver/ToolChains/Linux.cpp
+++ b/clang/lib/Driver/ToolChains/Linux.cpp
@@ -767,0 +768,24 @@ void Linux::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
+  // GCC-style hosted builds preinclude stdc-predef.h so libc can publish
+  // implementation contract macros such as __STDC_ISO_10646__. Clang does
+  // not do this by default, so musl targets can miss the wchar_t contract
+  // that projects like libedit validate before using wide-character APIs.
+  if (getTriple().isMusl() &&
+      DriverArgs.hasFlag(options::OPT_fhosted, options::OPT_ffreestanding,
+                         true) &&
+      !DriverArgs.hasArg(options::OPT_undef)) {
+    std::string StdCPredefInclude =
+        concat(SysRoot, "/usr/include/stdc-predef.h");
+    if (D.getVFS().exists(StdCPredefInclude)) {
+      CC1Args.push_back("-include");
+      CC1Args.push_back(DriverArgs.MakeArgString(StdCPredefInclude));
+    }
+  }
+
+  // musl-bsd overlays glibc/BSD declarations onto musl. Keep local and
+  // target-specific toolchain headers ahead of it, but place the overlay
+  // before the libc include roots so wrappers like <sys/stat.h> and
+  // <gnu/libc-version.h> are found without per-package flags.
+  if (getTriple().isMusl())
+    addSystemInclude(DriverArgs, CC1Args,
+                     concat(SysRoot, "/usr/lib/musl-bsd/overlay/include"));
+
