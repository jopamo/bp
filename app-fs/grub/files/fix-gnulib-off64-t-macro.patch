Respect the musl-bsd off64_t macro if an included header provides it
after configure's type probe. Otherwise the fallback typedef expands
to a conflicting typedef of off_t.

--- a/grub-core/lib/gnulib/sys_types.in.h
+++ b/grub-core/lib/gnulib/sys_types.in.h
@@ -61,7 +61,7 @@
 #endif

 /* Define the off64_t type.  */
-#if !@HAVE_OFF64_T@
+#if !@HAVE_OFF64_T@ && !defined off64_t
 # if !GNULIB_defined_off64_t
 /* Define off64_t to int64_t always.  */
 typedef long long off64_t;
