Subject: [PATCH] tests: match GObject type-registration callback signatures

Remove callback casts from the shared test registration helpers and give
all their non-NULL callbacks the signatures required by GType. Keep the
registration paths and assertions, including optional NULL callbacks.

Match the manually registered dynamic-interface initializer and finalizer
in the same default-interface test. Signal callbacks and the public dynamic
type/interface macros remain unchanged.

diff --git a/gobject/tests/testcommon.h b/gobject/tests/testcommon.h
--- a/gobject/tests/testcommon.h
+++ b/gobject/tests/testcommon.h
@@ -35,14 +35,14 @@
       static const GTypeInfo object_info =			\
 	{							\
 	  sizeof (name ## Class),				\
-	  (GBaseInitFunc) base_init,				\
+	  base_init,						\
 	  (GBaseFinalizeFunc) NULL,				\
-	  (GClassInitFunc) class_init,				\
+	  class_init,						\
 	  (GClassFinalizeFunc) NULL,				\
 	  NULL,           /* class_data */			\
 	  sizeof (name),					\
 	  0,             /* n_prelocs */			\
-	  (GInstanceInitFunc) instance_init,			\
+	  instance_init,					\
 	  (const GTypeValueTable *) NULL,			\
 	};							\
 								\
@@ -72,9 +72,9 @@
       static const GTypeInfo iface_info =			\
       {								\
 	sizeof (name ## Class),					\
-	(GBaseInitFunc)	base_init,				\
+	base_init,						\
 	(GBaseFinalizeFunc) NULL,				\
-	(GClassInitFunc) dflt_init,				\
+	dflt_init,						\
 	(GClassFinalizeFunc) NULL,				\
 	(gconstpointer) NULL,					\
 	(guint16) 0,						\
@@ -94,7 +94,7 @@
 {								\
   static GInterfaceInfo const iface =				\
     {								\
-      (GInterfaceInitFunc) init_func, NULL, NULL		\
+      init_func, NULL, NULL					\
     };								\
 								\
   g_type_add_interface_static (type, iface_type, &iface);	\
